# Maintainer: Oddbench <support@oddbench.co>
# The AUR package "jellybridge", built from the release source. Unlike the
# other Linux packages it does not bundle libmpv: Arch's own mpv is current
# (libmpv.so.2) and has the full FFmpeg, so the app loads the system one and
# it is updated with the system. "jellybridge-bin" (PKGBUILD-bin) is the
# prebuilt alternative. scripts/aur.sh fills in the checksum and publishes.
pkgname=jellybridge
pkgver=0.1.0
pkgrel=1
pkgdesc='Native desktop client for Jellyfin'
arch=('x86_64')
url='https://jellybridge.oddbench.co'
license=('GPL-3.0-or-later')
depends=('mpv' 'gcc-libs' 'glibc' 'libglvnd' 'libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxi' 'libxrandr' 'hicolor-icon-theme')
makedepends=('cargo' 'imagemagick')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/oddbench-co/jellybridge/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p jellybridge-app
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/jellybridge "$pkgdir/usr/bin/jellybridge"
    install -Dm644 packaging/linux/co.oddbench.JellyBridge.desktop "$pkgdir/usr/share/applications/co.oddbench.JellyBridge.desktop"
    install -Dm644 packaging/linux/co.oddbench.JellyBridge.metainfo.xml "$pkgdir/usr/share/metainfo/co.oddbench.JellyBridge.metainfo.xml"
    install -Dm644 rust/app/assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/co.oddbench.JellyBridge.svg"
    local size
    for size in 32 48 64 128 256 512; do
        install -dm755 "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
        magick rust/app/assets/icon.png -resize "${size}x${size}" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/co.oddbench.JellyBridge.png"
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 THIRD-PARTY-NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.md"
}
