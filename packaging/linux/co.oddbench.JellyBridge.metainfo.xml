<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>co.oddbench.JellyBridge</id>
  <name>JellyBridge</name>
  <summary>Native desktop client for Jellyfin</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="co.oddbench">
    <name>Oddbench</name>
  </developer>
  <description>
    <p>
      JellyBridge browses and plays your Jellyfin library in a fast native window:
      home, libraries, search, detail pages and a full player with subtitles and
      hardware-accelerated decoding. All common video codecs are included, so
      nothing else needs to be installed.
    </p>
    <p>
      It follows the layout of Jellyfin's own web app, so everything is where you
      expect it, and starts in well under a second with a small memory footprint.
      Playback is done by mpv: audio and subtitle tracks, chapters, playback speed,
      next episode, and skip buttons for intros and recaps, every control with a
      keyboard shortcut.
    </p>
    <p>
      JellyBridge is an independent project, not affiliated with the Jellyfin
      project. It needs a Jellyfin server to connect to (tested with Jellyfin 10.11 and 12).
    </p>
  </description>
  <launchable type="desktop-id">co.oddbench.JellyBridge.desktop</launchable>
  <provides>
    <binary>jellybridge</binary>
  </provides>
  <url type="homepage">https://jellybridge.oddbench.co</url>
  <url type="bugtracker">https://github.com/oddbench-co/jellybridge/issues</url>
  <url type="help">https://jellybridge.oddbench.co/docs</url>
  <url type="faq">https://jellybridge.oddbench.co/faq</url>
  <url type="vcs-browser">https://github.com/oddbench-co/jellybridge</url>
  <url type="contribute">https://jellybridge.oddbench.co/docs/contributing</url>
  <branding>
    <color type="primary" scheme_preference="light">#eef0ff</color>
    <color type="primary" scheme_preference="dark">#312e81</color>
  </branding>
