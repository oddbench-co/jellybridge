import { Button, Slider } from "std-widgets.slint";

export component PlayerSliceWindow inherits Window {
    title: "JellyBridge Embedded Player Slice";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 480px;
    background: #111416;

    in property <image> video-frame;
    in-out property <string> status: "Renderer initialized; no media loaded";
    in-out property <bool> paused: false;
    in-out property <float> volume: 100;
    out property <float> video-logical-width: video-surface.width / 1px;
    out property <float> video-logical-height: video-surface.height / 1px;
    callback toggle-playback();
    callback seek-relative(float);
    callback volume-changed(float);
    callback toggle-fullscreen();
    callback stop-playback();

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        HorizontalLayout {
            Text {
                text: "JellyBridge — embedded libmpv feasibility slice";
                color: #00a4dc;
                font-size: 22px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                color: #aeb8bd;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        video-surface := Rectangle {
            background: #050607;
            border-color: #293238;
            border-width: 1px;
            border-radius: 8px;
            vertical-stretch: 1;
            clip: true;

            Image {
                source: root.video-frame;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                text: root.paused ? "Play" : "Pause";
                clicked => { root.toggle-playback(); }
            }
            Button {
                text: "−10 s";
                clicked => { root.seek-relative(-10); }
            }
            Button {
                text: "+10 s";
                clicked => { root.seek-relative(10); }
            }
            Text {
                text: "Volume";
                color: #dbe3e7;
                vertical-alignment: center;
            }
            Slider {
                minimum: 0;
                maximum: 100;
                value: root.volume;
                width: 190px;
                changed(value) => {
                    root.volume = value;
                    root.volume-changed(value);
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Fullscreen";
                clicked => { root.toggle-fullscreen(); }
            }
            Button {
                text: "Stop";
                clicked => { root.stop-playback(); }
            }
        }
    }

    // Certification sentinel: when enabled, the integration samples this pixel
    // after Slint draws. A mismatch exposes GL state leakage from libmpv.
    Rectangle {
        x: 4px;
        y: 4px;
        width: 8px;
        height: 8px;
        background: #ff00ff;
        visible: true;
    }
}
