// Full-width scroll layer for a horizontal shelf. Applies horizontal deltas
// (accelerated) to offset-x and locks each gesture to one axis: the first
// event picks horizontal or vertical, and the lock holds until scroll events
// pause. Vertical events are rejected so the surrounding ListView/ScrollView
// scrolls natively.
export component ShelfScrollArea inherits TouchArea {
    in property <length> viewport-width;
    in property <length> content-width;
    in property <length> minimum-offset;
    in-out property <length> offset-x;

    // 3x makes a wheel tick / trackpad flick cover a useful distance.
    in property <float> speed: 3.0;

    // 0 = unlocked, 1 = horizontal, 2 = vertical
    private property <int> axis: 0;

    // Slint scroll events carry no begin/end phase, so a short idle timer
    // defines "gesture ended" and releases the axis lock.
    axis-reset := Timer {
        running: false;
        interval: 200ms;
        triggered => {
            self.stop();
            root.axis = 0;
        }
    }

    // offset-x is plain state, clamped only where it is written and so valid
    // only against the bounds in force at that moment. Widening the window
    // shrinks the scrollable range, leaving a previously-captured offset past
    // the new end: the shelf renders blank space after the last card until the
    // next wheel tick snaps it back. Re-clamp whenever the range changes.
    // (minimum-offset derives from both viewport-width and content-width, so
    // this covers a resize and a change of item count alike.)
    changed minimum-offset => {
        root.offset-x = clamp(root.offset-x, root.minimum-offset, 0px);
        // A resize ends whatever gesture was in flight: the lock was taken
        // against the old geometry and must not outlive it.
        root.axis = 0;
        axis-reset.stop();
    }

    scroll-event(event) => {
        // A shelf whose cards already fit can never own a horizontal gesture,
        // so it must never hold a lock -- re-checked on every event rather than
        // only when the lock is taken. Moving the window to an empty workspace
        // retiles it full-width, which flips a shelf from overflowing to
        // fitting; a lock taken just before that flip would otherwise keep
        // swallowing (`accept`) the page's vertical scrolling. And since every
        // event restarts the release timer, scrolling without pausing held the
        // stale lock open indefinitely -- the page only recovered once the user
        // stopped long enough for the 200ms timer to fire.
        if root.content-width <= root.viewport-width {
            root.axis = 0;
            axis-reset.stop();
            return reject;
        }
        if root.axis == 0 {
            root.axis = abs(event.delta-x) > abs(event.delta-y) && root.content-width > root.viewport-width
                ? 1
                : 2;
        }
        axis-reset.restart();
        if root.axis == 1 {
            root.offset-x = clamp(
                root.offset-x + event.delta-x * root.speed,
                root.minimum-offset,
                0px
            );
            // Swallow the whole event so its vertical component cannot
            // scroll the page mid-gesture.
            return accept;
        }
        // Vertical gesture: the shelf never moves; the outer view scrolls.
        return reject;
    }
}
