import { Theme } from "../theme.slint";

// Shared chrome above the catalog and detail screens: back, brand/home,
// current title, account, and sign-out.
export component TopBar inherits Rectangle {
    in property <bool> show-back;
    in property <bool> home-active;
    in property <string> title;
    in property <string> account-name;
    in property <string> account-initial;

    callback go-back();
    callback go-home();
    callback logout();

    height: 64px;
    background: Theme.bg.with-alpha(0.96);

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.surface-hover;
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 10px;
        padding-bottom: 11px;
        spacing: 10px;

        Rectangle {
            width: 42px;
            border-radius: 21px;
            background: back-touch.has-hover ? Theme.surface-hover : Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            visible: root.show-back;
            Text {
                text: "‹";
                color: Theme.text-primary;
                font-size: 27px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            back-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.go-back(); }
            }
        }

        brand := Rectangle {
            width: 172px;
            background: transparent;
            Rectangle {
                x: 0px;
                y: 2px;
                width: 38px;
                height: 38px;
                border-radius: Theme.radius-large;
                background: @linear-gradient(145deg, Theme.accent 0%, Theme.accent-deep 100%);
                Image {
                    source: @image-url("../../assets/icon.png");
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                }
            }
            Text {
                x: 49px;
                text: "JellyBridge";
                color: Theme.text-primary;
                font-size: 19px;
                font-weight: 760;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.go-home(); }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        Rectangle {
            width: 70px;
            border-radius: Theme.radius-medium;
            background: root.home-active
                ? Theme.accent-surface
                : home-touch.has-hover ? Theme.surface-raised : transparent;
            Text {
                text: "Home";
                color: root.home-active ? Theme.accent-bright : Theme.text-secondary;
                font-size: 13px;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            home-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.go-home(); }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.title;
            color: Theme.text-faint;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            width: 174px;
            border-radius: 21px;
            background: Theme.surface;
            border-color: Theme.surface-hover;
            border-width: 1px;

            Rectangle {
                x: 5px;
                y: 4px;
                width: 34px;
                height: 34px;
                border-radius: 17px;
                background: Theme.accent-deep;
                Text {
                    text: root.account-initial;
                    color: white;
                    font-size: 15px;
                    font-weight: 750;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                x: 48px;
                width: parent.width - 58px;
                text: root.account-name;
                color: Theme.text-secondary;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle {
            width: 82px;
            border-radius: Theme.radius-medium;
            background: logout-touch.has-hover ? Theme.danger-surface : transparent;
            border-color: logout-touch.has-hover ? Theme.danger-border : Theme.border;
            border-width: 1px;
            Text {
                text: "Sign out";
                color: logout-touch.has-hover ? Theme.danger-text : Theme.text-muted;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            logout-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.logout(); }
            }
        }
    }
}
