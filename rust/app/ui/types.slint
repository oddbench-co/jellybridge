// Boundary types shared between Slint and Rust. Rust converts its domain
// types into these at the UI boundary; nothing else crosses it.

export enum Screen {
    login,
    catalog,
    detail,
    player,
}

export enum DetailKind {
    movie,
    series,
    season,
    episode,
    other,
}

export struct CatalogSection {
    id: string,
    title: string,
    start-index: int,
    count: int,
}

export struct CatalogItem {
    id: string,
    title: string,
    subtitle: string,
    kind-label: string,
    kind: string,
    placeholder: string,
    artwork: image,
    watched: bool,
    progress: float,
    is-container: bool,
    playable: bool,
}

export struct DetailCard {
    id: string,
    title: string,
    subtitle: string,
    overview: string,
    kind: string,
    artwork: image,
    watched: bool,
    favorite: bool,
    progress: float,
    unplayed-count: int,
}

export struct DetailPerson {
    id: string,
    name: string,
    role: string,
    artwork: image,
}
