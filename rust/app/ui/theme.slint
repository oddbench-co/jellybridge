// Design tokens: the single source of truth for color, spacing, radius, and
// type. Components must reference Theme.* instead of hard-coding values;
// near-duplicate shades were deliberately collapsed onto this palette.

export global Theme {
    // Background ramp (darkest → lightest)
    out property <color> bg: #0f1214;              // window and page ground
    out property <color> surface-dim: #151b1e;     // gradient ends, wells
    out property <color> surface: #1b2428;         // panels, cards
    out property <color> surface-raised: #232c30;  // inputs, chips at rest
    out property <color> surface-hover: #2b383d;   // hovered controls
    out property <color> border: #36454b;          // hairlines, outlines
    out property <color> border-strong: #52666f;   // emphasized outlines, icons

    // Text ramp (brightest → faintest)
    out property <color> text-bright: #ffffff;     // buttons, hero titles
    out property <color> text-primary: #f5f8f9;    // headings, body
    out property <color> text-secondary: #c8d1d5;  // supporting copy
    out property <color> text-muted: #aeb8bd;      // labels, captions
    out property <color> text-faint: #82929a;      // hints, disabled

    // Accent (Jellyfin blue)
    out property <color> accent: #00a4dc;
    out property <color> accent-bright: #62ccee;   // links, highlights on dark
    out property <color> accent-deep: #006f98;     // pressed / selected fill
    out property <color> accent-surface: #173d4b;  // tinted chips and fills

    // Feedback
    out property <color> rating-gold: #f2b01e;      // community-rating star
    out property <color> danger-text: #ffb1b1;
    out property <color> danger-surface: #3a1f22;
    out property <color> danger-border: #77414d;

    // Player
    out property <color> video-bg: #050607;        // letterbox behind video
    out property <color> scrim: #000000;           // use with .with-alpha()
    out property <color> overlay: #171e21e5;       // floating player chrome
    out property <color> overlay-raised: #2b393fef;
    out property <color> overlay-dim: #151b1ee0;

    // Radii
    out property <length> radius-small: 6px;
    out property <length> radius-medium: 8px;
    out property <length> radius-large: 12px;

    // Spacing scale
    out property <length> space-xs: 4px;
    out property <length> space-small: 8px;
    out property <length> space-medium: 12px;
    out property <length> space-large: 16px;
    out property <length> space-xl: 24px;

    // Type scale
    out property <length> font-xs: 10px;
    out property <length> font-caption: 11px;
    out property <length> font-body: 12px;
    out property <length> font-body-large: 13px;
    out property <length> font-subtitle: 14px;
    out property <length> font-title: 16px;
    out property <length> font-heading: 21px;
    out property <length> font-display: 27px;
}
