import { CatalogSection, CatalogItem, DetailCard, DetailPerson, ChapterMarker, ExternalLink, Screen, DetailKind } from "types.slint";
import { Theme } from "theme.slint";
import { TopBar } from "components/top-bar.slint";
import { LoginScreen } from "features/login/login-screen.slint";
import { CatalogScreen } from "features/catalog/catalog-screen.slint";
import { DetailScreen } from "features/detail/detail-screen.slint";
import { PlayerScreen } from "features/player/player-screen.slint";

export { CatalogSection, CatalogItem, DetailCard, DetailPerson, ChapterMarker, ExternalLink, Screen, DetailKind }

// Composition root: owns the Rust-facing property/callback boundary, the
// screen switch, and global hotkey focus. Screens are implemented in
// features/; this file only assembles them.
export component JellyBridgeWindow inherits Window {
    title: "JellyBridge";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.bg;

    // `in`: Rust owns it. `in-out`: genuinely edited from both sides.
    // `private`: nobody outside this component should know it exists.
    in property <Screen> screen: Screen.login;
    in property <bool> busy: false;
    in property <string> message: "";
    in property <string> page-title: "Home";
    in property <string> account-name: "";
    in property <string> account-initial: "?";
    in property <bool> can-go-back: false;
    in property <[CatalogSection]> sections;
    in property <[CatalogItem]> catalog-items;
    in property <string> catalog-summary: "";
    in property <bool> catalog-home: false;
    in-out property <string> search-text: "";
    in property <[string]> sort-options;
    in-out property <int> sort-index: 0;
    in-out property <int> density-index: 1;
    in property <float> tile-target-width: 260;

    in property <string> detail-id: "";
    in property <string> detail-title: "";
    in property <string> detail-heading: "";
    in property <string> detail-subheading: "";
    in property <string> detail-ends-at: "";
    in property <string> detail-tags: "";
    in property <[ExternalLink]> detail-links;
    in property <string> detail-director: "";
    in property <string> detail-writers: "";
    in property <float> detail-star-rating: 0;
    in property <int> detail-critic-rating: -1;
    in property <string> detail-subtitle: "";
    in property <string> detail-overview: "";
    in property <image> detail-artwork;
    in property <image> detail-backdrop;
    in property <image> detail-logo;
    in property <DetailKind> detail-kind: DetailKind.other;
    in property <string> detail-tagline: "";
    in property <string> detail-genres: "";
    in property <string> detail-studios: "";
    in property <string> detail-media-info: "";
    in property <string> detail-series-id: "";
    in property <string> detail-series-name: "";
    in property <string> detail-series-summary: "";
    in property <string> detail-play-context: "";
    in property <string> detail-season-id: "";
    in property <string> detail-season-name: "";
    in property <string> detail-season-summary: "";
    in property <string> detail-play-label: "";
    in property <float> detail-progress: 0;
    in property <string> detail-progress-label: "";
    in property <bool> detail-playable: false;
    in property <bool> detail-watched: false;
    in property <bool> detail-favorite: false;
    in property <[DetailCard]> detail-seasons;
    in property <[DetailCard]> detail-next-up;
    in property <[DetailCard]> detail-episodes;
    in property <[DetailPerson]> detail-people;
    in property <[string]> detail-audio-options;
    in property <[string]> detail-subtitle-options;
    in-out property <int> detail-audio-index: 0;
    in-out property <int> detail-subtitle-index: 0;

    in property <image> video-frame;
    in property <string> player-status: "Preparing playback…";
    in property <bool> paused: false;
    in-out property <float> volume: 100;
    in property <bool> fullscreen-player: false;
    in property <bool> controls-visible: true;
    in-out property <float> playback-position: 0;
    in-out property <float> playback-duration: 0;
    private property <float> timeline-position: 0;
    private property <bool> timeline-scrubbing: false;
    out property <float> timeline-display-position: root.timeline-position;
    in property <string> playback-position-label: "0:00";
    in property <string> playback-duration-label: "0:00";
    in property <[ChapterMarker]> chapters;
    in property <[string]> audio-options;
    in property <[string]> subtitle-options;
    in-out property <int> audio-index: 0;
    in-out property <int> subtitle-index: 0;
    out property <float> video-logical-width: root.width / 1px;
    out property <float> video-logical-height: max(root.height - 112px, 1px) / 1px;

    callback login(string, string, string);
    callback logout();
    callback retry();
    callback open-item(string, string, bool, bool);
    callback search(string);
    callback sort-changed(int);
    callback density-changed(int);
    callback go-home();
    callback go-back();
    callback play-current();
    callback play-current-from-start();
    callback open-external-url(string);
    callback open-detail(string, string);
    callback play-detail(string);
    callback set-detail-watched(string, bool);
    callback set-detail-favorite(string, bool);
    callback detail-audio-selected(int);
    callback detail-subtitle-selected(int);
    callback toggle-playback();
    callback toggle-mute();
    callback seek-relative(float);
    callback volume-changed(float);
    callback seek-absolute(float);
    callback select-audio(int);
    callback select-subtitle(int);
    callback toggle-fullscreen();
    callback player-activity();
    callback leave-player();
    callback player-key-pressed(string, bool, bool, bool) -> bool;

    // Initializes the timeline and grabs hotkey focus. Rust sets `screen` to
    // Screen.player itself before invoking this — a component cannot assign
    // its own `in` property.
    public function enter-player(initial-position: float, initial-duration: float) {
        root.playback-duration = max(initial-duration, 0);
        root.playback-position = clamp(initial-position, 0, max(root.playback-duration, 1));
        root.timeline-position = root.playback-position;
        root.timeline-scrubbing = false;
        app-key-scope.focus();
    }

    changed playback-position => {
        if !root.timeline-scrubbing {
            root.timeline-position = clamp(root.playback-position, 0, max(root.playback-duration, 1));
        }
    }

    changed playback-duration => {
        if !root.timeline-scrubbing {
            root.timeline-position = clamp(root.playback-position, 0, max(root.playback-duration, 1));
        }
    }

    forward-focus: app-key-scope;

    app-key-scope := FocusScope {
        capture-key-pressed(event) => {
            if root.screen == Screen.player && root.player-key-pressed(
                event.text,
                event.repeat,
                event.modifiers.shift,
                event.modifiers.control || event.modifiers.meta || event.modifiers.alt
            ) {
                return accept;
            }
            return reject;
        }

        if root.screen == Screen.login: LoginScreen {
            busy: root.busy;
            message: root.message;
            login(server, username, password) => { root.login(server, username, password); }
        }

        if root.screen == Screen.catalog || root.screen == Screen.detail: VerticalLayout {
            spacing: 0px;

            TopBar {
                show-back: root.can-go-back || root.screen == Screen.detail;
                home-active: root.catalog-home && root.screen == Screen.catalog;
                title: root.screen == Screen.detail ? root.detail-title : root.page-title;
                account-name: root.account-name;
                account-initial: root.account-initial;
                go-back => { root.go-back(); }
                go-home => { root.go-home(); }
                logout => { root.logout(); }
            }

            if root.screen == Screen.catalog: CatalogScreen {
                busy: root.busy;
                message: root.message;
                page-title: root.page-title;
                catalog-summary: root.catalog-summary;
                catalog-home: root.catalog-home;
                sections: root.sections;
                catalog-items: root.catalog-items;
                sort-options: root.sort-options;
                tile-target-width: root.tile-target-width;
                search-text <=> root.search-text;
                sort-index <=> root.sort-index;
                density-index <=> root.density-index;
                search(term) => { root.search(term); }
                sort-changed(index) => { root.sort-changed(index); }
                density-changed(index) => { root.density-changed(index); }
                open-item(id, kind, is-container, playable) => { root.open-item(id, kind, is-container, playable); }
                retry => { root.retry(); }
            }

            if root.screen == Screen.detail: DetailScreen {
                vertical-stretch: 1;
                busy: root.busy;
                message: root.message;
                detail-id: root.detail-id;
                detail-title: root.detail-title;
                detail-heading: root.detail-heading;
                detail-subheading: root.detail-subheading;
                detail-ends-at: root.detail-ends-at;
                detail-tags: root.detail-tags;
                detail-links: root.detail-links;
                detail-director: root.detail-director;
                detail-writers: root.detail-writers;
                detail-star-rating: root.detail-star-rating;
                detail-critic-rating: root.detail-critic-rating;
                detail-subtitle: root.detail-subtitle;
                detail-overview: root.detail-overview;
                detail-artwork: root.detail-artwork;
                detail-backdrop: root.detail-backdrop;
                detail-logo: root.detail-logo;
                detail-kind: root.detail-kind;
                detail-tagline: root.detail-tagline;
                detail-genres: root.detail-genres;
                detail-studios: root.detail-studios;
                detail-media-info: root.detail-media-info;
                detail-series-id: root.detail-series-id;
                detail-series-name: root.detail-series-name;
                detail-series-summary: root.detail-series-summary;
                detail-play-context: root.detail-play-context;
                detail-season-id: root.detail-season-id;
                detail-season-name: root.detail-season-name;
                detail-season-summary: root.detail-season-summary;
                detail-play-label: root.detail-play-label;
                detail-progress: root.detail-progress;
                detail-progress-label: root.detail-progress-label;
                detail-playable: root.detail-playable;
                detail-watched: root.detail-watched;
                detail-favorite: root.detail-favorite;
                detail-seasons: root.detail-seasons;
                detail-next-up: root.detail-next-up;
                detail-episodes: root.detail-episodes;
                detail-people: root.detail-people;
                detail-audio-options: root.detail-audio-options;
                detail-subtitle-options: root.detail-subtitle-options;
                detail-audio-index <=> root.detail-audio-index;
                detail-subtitle-index <=> root.detail-subtitle-index;
                play-current => { root.play-current(); }
                play-current-from-start => { root.play-current-from-start(); }
                open-external-url(url) => { root.open-external-url(url); }
                play-detail(id) => { root.play-detail(id); }
                open-detail(id, kind) => { root.open-detail(id, kind); }
                set-detail-watched(id, watched) => { root.set-detail-watched(id, watched); }
                set-detail-favorite(id, favorite) => { root.set-detail-favorite(id, favorite); }
                detail-audio-selected(index) => { root.detail-audio-selected(index); }
                detail-subtitle-selected(index) => { root.detail-subtitle-selected(index); }
                retry => { root.retry(); }
            }
        }

        if root.screen == Screen.player: PlayerScreen {
            video-frame: root.video-frame;
            title: root.detail-title;
            player-status: root.player-status;
            paused: root.paused;
            fullscreen-player: root.fullscreen-player;
            controls-visible: root.controls-visible;
            playback-position-label: root.playback-position-label;
            playback-duration-label: root.playback-duration-label;
            playback-duration: root.playback-duration;
            chapters: root.chapters;
            audio-options: root.audio-options;
            subtitle-options: root.subtitle-options;
            audio-index <=> root.audio-index;
            subtitle-index <=> root.subtitle-index;
            volume <=> root.volume;
            timeline-position <=> root.timeline-position;
            timeline-scrubbing <=> root.timeline-scrubbing;
            toggle-playback => { root.toggle-playback(); }
            toggle-fullscreen => { root.toggle-fullscreen(); }
            seek-relative(seconds) => { root.seek-relative(seconds); }
            seek-absolute(seconds) => { root.seek-absolute(seconds); }
            scrub-finished(seconds) => {
                root.playback-position = seconds;
                root.timeline-scrubbing = false;
            }
            select-audio(index) => { root.select-audio(index); }
            select-subtitle(index) => { root.select-subtitle(index); }
            volume-changed(volume) => { root.volume-changed(volume); }
            player-activity => { root.player-activity(); }
            leave-player => { root.leave-player(); }
        }
    }
}
