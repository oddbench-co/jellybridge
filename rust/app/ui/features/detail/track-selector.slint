import { ComboBox } from "std-widgets.slint";
import { Theme } from "../../theme.slint";

export component DetailTrackSelector inherits Rectangle {
    in property <string> label;
    in property <[string]> options;
    in-out property <int> selected-index: 0;
    callback selected(int);

    height: 40px;
    background: Theme.overlay-dim;
    border-color: Theme.surface-hover;
    border-width: 1px;
    border-radius: Theme.radius-small;

    Text {
        x: 10px;
        y: 0px;
        width: 62px;
        height: parent.height;
        text: root.label;
        color: Theme.text-faint;
        font-size: 10px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    ComboBox {
        x: 70px;
        y: 5px;
        width: parent.width - 76px;
        height: 30px;
        model: root.options;
        current-index: root.selected-index;
        selected(_) => {
            root.selected-index = self.current-index;
            root.selected(self.current-index);
        }
    }
}
