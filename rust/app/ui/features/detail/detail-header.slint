import { Theme } from "../../theme.slint";
import { DetailKind } from "../../types.slint";
import { DetailActionButton } from "action-button.slint";
import { DetailBreadcrumbLink } from "breadcrumb-link.slint";
import { DetailTrackSelector } from "track-selector.slint";

// The one detail-page header, parametrized by `kind`. It replaces the four
// near-identical header variants; per-kind differences are data-driven:
//   - movie/episode: accent metadata, resume progress, track selectors
//   - series:        summary line, next-episode context with progress
//   - season:        summary line, short overview, series breadcrumb
//   - other:         logo, long overview, genres/studios/media-info
export component DetailHeader inherits Rectangle {
    in property <DetailKind> kind: DetailKind.other;
    in property <string> title;
    in property <string> tagline;
    in property <string> metadata;
    in property <string> summary;
    in property <string> overview;
    in property <string> genres;
    in property <string> studios;
    in property <string> media-info;
    in property <string> series-id;
    in property <string> series-name;
    in property <string> season-id;
    in property <string> season-name;
    in property <image> poster;
    in property <image> backdrop;
    in property <image> logo;
    in property <bool> wide-art: false;
    in property <string> play-label;
    in property <string> progress-text;
    in property <float> progress: 0;
    in property <bool> playable: false;
    in property <bool> watched: false;
    in property <bool> favorite: false;
    in property <bool> busy: false;
    in property <[string]> audio-options;
    in property <[string]> subtitle-options;
    in-out property <int> audio-index: 0;
    in-out property <int> subtitle-index: 0;

    callback play();
    callback set-watched(watched: bool);
    callback set-favorite(favorite: bool);
    callback audio-selected(index: int);
    callback subtitle-selected(index: int);
    callback open-related(id: string, kind: string);

    private property <bool> is-media: root.kind == DetailKind.movie || root.kind == DetailKind.episode;
    private property <bool> is-other: root.kind == DetailKind.other;
    private property <bool> poster-wide: root.kind == DetailKind.episode || (root.is-other && root.wide-art);
    private property <bool> show-tracks: (root.is-media || root.is-other)
        && (root.audio-options.length > 1 || root.subtitle-options.length > 1);
    private property <bool> show-breadcrumbs: root.kind != DetailKind.series
        && (root.series-id != "" || root.season-id != "" || root.kind == DetailKind.season);
    private property <int> track-option-count: (root.audio-options.length > 1 ? 1 : 0)
        + (root.subtitle-options.length > 1 ? 1 : 0);
    private property <length> track-column-width: min(root.width - 56px, 1180px)
        - (root.poster-wide ? 304px : 168px);
    private property <length> track-card-width: root.track-option-count == 1
        ? min(240px, root.track-column-width)
        : min(225px, (root.track-column-width - 8px) / 2);

    height: root.is-other ? 400px : root.show-tracks ? 350px : 300px;
    background: Theme.bg;
    clip: true;

    Image { source: root.backdrop; width: 100%; height: 100%; image-fit: cover; }
    Rectangle { background: @linear-gradient(90deg, Theme.bg.with-alpha(0.99) 0%, Theme.bg.with-alpha(0.86) 58%, Theme.bg.with-alpha(0.46) 100%); }
    Rectangle { background: @linear-gradient(180deg, Theme.bg.with-alpha(0.15) 0%, Theme.bg 100%); }

    content := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 24px;
        width: min(parent.width - 56px, 1180px);
        height: parent.height - 48px;

        HorizontalLayout {
            spacing: 24px;

            poster-card := Rectangle {
                width: root.poster-wide ? 280px : root.is-other ? 205px : 144px;
                height: root.poster-wide ? 158px : root.is-other ? 308px : 216px;
                background: Theme.surface;
                border-radius: Theme.radius-medium;
                border-color: Theme.border;
                border-width: 1px;
                clip: true;
                drop-shadow-color: Theme.scrim.with-alpha(0.56);
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 5px;

                Text {
                    text: root.title;
                    color: Theme.border-strong;
                    font-size: 14px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Image { source: root.poster; width: 100%; height: 100%; image-fit: cover; }
            }

            VerticalLayout {
                spacing: 7px;

                HorizontalLayout {
                    height: 30px;
                    spacing: 5px;
                    visible: root.show-breadcrumbs;
                    DetailBreadcrumbLink {
                        text: root.series-name == "" ? "Series" : root.series-name;
                        width-limit: 180px;
                        visible: root.series-id != "";
                        clicked => { root.open-related(root.series-id, "Series"); }
                    }
                    Text {
                        text: "›";
                        color: Theme.text-faint;
                        font-size: 17px;
                        vertical-alignment: center;
                        visible: root.series-id != "" && (root.season-id != "" || root.kind == DetailKind.season);
                    }
                    DetailBreadcrumbLink {
                        text: root.season-name == "" ? "Season" : root.season-name;
                        width-limit: 140px;
                        visible: root.kind != DetailKind.season && root.season-id != "";
                        clicked => { root.open-related(root.season-id, "Season"); }
                    }
                    Text {
                        text: root.title;
                        color: Theme.text-muted;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                        visible: root.kind == DetailKind.season;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                Image {
                    source: root.logo;
                    width: 320px;
                    height: 74px;
                    image-fit: contain;
                    visible: root.is-other && root.logo.width > 0;
                }
                Text {
                    text: root.title;
                    color: Theme.text-bright;
                    font-size: 31px;
                    font-weight: 800;
                    wrap: word-wrap;
                    max-height: 68px;
                    overflow: elide;
                }
                Text {
                    text: root.tagline;
                    color: Theme.text-secondary;
                    font-size: 13px;
                    visible: root.tagline != "";
                    overflow: elide;
                }
                Text {
                    text: root.metadata;
                    color: root.is-media ? Theme.accent-bright : Theme.text-secondary;
                    font-size: 13px;
                    font-weight: root.is-media ? 600 : 400;
                    visible: root.metadata != "";
                    overflow: elide;
                }
                Text {
                    text: root.summary;
                    color: Theme.accent-bright;
                    font-size: 13px;
                    font-weight: 650;
                    visible: (root.kind == DetailKind.series || root.kind == DetailKind.season) && root.summary != "";
                    overflow: elide;
                }
                Text {
                    text: root.overview == "" ? "No overview available." : root.overview;
                    color: Theme.text-secondary;
                    font-size: 13px;
                    wrap: word-wrap;
                    max-height: root.is-other ? 82px : 50px;
                    overflow: elide;
                    visible: root.is-other || root.kind == DetailKind.season;
                }
                Text {
                    text: "Genres  " + root.genres;
                    color: Theme.text-muted;
                    font-size: 12px;
                    visible: root.is-other && root.genres != "";
                    overflow: elide;
                }
                Text {
                    text: "Studio  " + root.studios;
                    color: Theme.text-muted;
                    font-size: 12px;
                    visible: root.is-other && root.studios != "";
                    overflow: elide;
                }
                Text {
                    text: root.media-info;
                    color: Theme.text-faint;
                    font-size: 11px;
                    visible: root.is-other && root.media-info != "";
                    overflow: elide;
                }

                HorizontalLayout {
                    height: 20px;
                    spacing: 10px;
                    visible: !root.is-other && root.progress-text != "";
                    Text {
                        width: 190px;
                        text: root.progress-text;
                        color: Theme.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        height: 5px;
                        background: Theme.surface-hover;
                        border-radius: 2px;
                        vertical-stretch: 0;
                        visible: root.progress > 0 && root.progress < 1;
                        Rectangle {
                            x: 0px;
                            width: parent.width * root.progress;
                            height: 100%;
                            background: Theme.accent;
                            border-radius: 2px;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    height: 40px;
                    spacing: 9px;
                    DetailActionButton {
                        width: root.poster-wide ? 104px : 118px;
                        text: root.play-label == "" ? "Play" : root.play-label;
                        primary: true;
                        visible: root.playable;
                        enabled: !root.busy;
                        clicked => { root.play(); }
                    }
                    DetailActionButton {
                        width: root.poster-wide ? 128px : 142px;
                        text: root.watched ? "✓ Watched" : "Mark watched";
                        active: root.watched;
                        enabled: !root.busy;
                        clicked => { root.set-watched(!root.watched); }
                    }
                    DetailActionButton {
                        width: root.poster-wide ? 118px : 132px;
                        text: root.favorite ? "★ Favorite" : "☆ Favorite";
                        active: root.favorite;
                        enabled: !root.busy;
                        clicked => { root.set-favorite(!root.favorite); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    height: 40px;
                    spacing: 8px;
                    visible: root.show-tracks;

                    DetailTrackSelector {
                        width: root.track-card-width;
                        label: "Audio";
                        options: root.audio-options;
                        selected-index <=> root.audio-index;
                        visible: root.audio-options.length > 1;
                        selected(index) => { root.audio-selected(index); }
                    }
                    DetailTrackSelector {
                        width: root.track-card-width;
                        label: "Subtitles";
                        options: root.subtitle-options;
                        selected-index <=> root.subtitle-index;
                        visible: root.subtitle-options.length > 1;
                        selected(index) => { root.subtitle-selected(index); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}
