import { Theme } from "../../theme.slint";
import { Icons } from "../../components/icons.slint";
import { DetailCard } from "../../types.slint";
import { DetailIconButton } from "icon-button.slint";

// Jellyfin-style season episode row: wide thumbnail that plays on click,
// title that opens the episode, meta line, overview, and icon actions.
export component DetailEpisodeRow inherits Rectangle {
    in property <DetailCard> episode;
    in property <bool> busy: false;
    callback open(id: string, kind: string);
    callback play(id: string);
    callback set-watched(id: string, watched: bool);
    callback set-favorite(id: string, favorite: bool);

    background: transparent;

    HorizontalLayout {
        spacing: 18px;

        thumb := Rectangle {
            width: 240px;
            height: 135px;
            y: 4px;
            background: Theme.surface;
            border-radius: Theme.radius-medium;
            border-color: thumb-touch.has-hover ? Theme.border-strong : Theme.surface-hover;
            border-width: 1px;
            clip: true;
            drop-shadow-color: Theme.scrim.with-alpha(0.44);
            drop-shadow-blur: 8px;
            drop-shadow-offset-y: 3px;

            Text {
                text: root.episode.title;
                color: Theme.border-strong;
                font-size: 13px;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Image { source: root.episode.artwork; width: 100%; height: 100%; image-fit: cover; }

            if root.episode.watched: Rectangle {
                x: parent.width - 33px;
                y: 8px;
                width: 25px;
                height: 25px;
                border-radius: Theme.radius-large;
                background: Theme.accent;
                Path {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Icons.check;
                    fill: Theme.text-bright;
                }
            }

            if root.episode.progress > 0 && root.episode.progress < 1: Rectangle {
                x: 0px;
                y: parent.height - 5px;
                width: parent.width;
                height: 5px;
                background: Theme.overlay;
                Rectangle {
                    x: 0px;
                    width: parent.width * root.episode.progress;
                    height: 100%;
                    background: Theme.accent;
                }
            }

            // Hover play affordance; the whole thumbnail plays the episode.
            if thumb-touch.has-hover: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 46px;
                height: 46px;
                border-radius: 23px;
                background: Theme.scrim.with-alpha(0.63);
                Path {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 26px;
                    height: 26px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Icons.play;
                    fill: Theme.text-bright;
                }
            }

            thumb-touch := TouchArea {
                mouse-cursor: pointer;
                enabled: !root.busy;
                clicked => { root.play(root.episode.id); }
            }
        }

        VerticalLayout {
            spacing: 5px;
            horizontal-stretch: 1;

            title-line := Text {
                text: root.episode.index-label == ""
                    ? root.episode.title
                    : root.episode.index-label + " " + root.episode.title;
                color: title-touch.has-hover ? Theme.accent-bright : Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
                overflow: elide;
                title-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open(root.episode.id, root.episode.kind); }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                if root.episode.subtitle != "": Text {
                    text: root.episode.subtitle;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                if root.episode.rating > 0: Text {
                    text: "★ " + Math.round(root.episode.rating * 10) / 10;
                    color: Theme.rating-gold;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                if root.episode.ends-at != "": Text {
                    text: root.episode.ends-at;
                    color: Theme.text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }

            Text {
                text: root.episode.overview;
                color: Theme.text-muted;
                font-size: 12px;
                wrap: word-wrap;
                max-height: 54px;
                overflow: elide;
                visible: root.episode.overview != "";
            }
            Rectangle { vertical-stretch: 1; }
        }

        VerticalLayout {
            alignment: start;
            HorizontalLayout {
                spacing: 8px;
                padding-top: 4px;
                DetailIconButton {
                    icon: Icons.check;
                    label: "Played";
                    size: 34px;
                    active: root.episode.watched;
                    enabled: !root.busy;
                    clicked => { root.set-watched(root.episode.id, !root.episode.watched); }
                }
                DetailIconButton {
                    icon: Icons.favorite;
                    label: "Favorite";
                    active-color: Theme.danger-text;
                    size: 34px;
                    active: root.episode.favorite;
                    enabled: !root.busy;
                    clicked => { root.set-favorite(root.episode.id, !root.episode.favorite); }
                }
            }
        }
    }
}
