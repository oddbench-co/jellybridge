import { Theme } from "../../theme.slint";

// Round icon action button (restart, played, favorite, info, ...), drawn from
// the shared Material `Icons` path data. `active` marks a toggled state;
// `active-color` tints the icon then (the favorite heart turns red).
export component DetailIconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <color> active-color: Theme.text-bright;
    in property <bool> enabled: true;
    in property <length> size: 44px;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.primary
        ? (icon-touch.has-hover ? Theme.accent-bright : Theme.accent)
        : root.active
            ? Theme.accent-deep
            : icon-touch.has-hover ? Theme.surface-hover : Theme.surface-raised;
    border-color: root.primary || root.active ? transparent : Theme.border;
    border-width: 1px;
    opacity: root.enabled ? 1.0 : 0.45;

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size * 0.5;
        height: self.width;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        fill: root.primary ? Theme.bg
            : root.active ? root.active-color
            : Theme.text-secondary;
    }
    icon-touch := TouchArea {
        mouse-cursor: pointer;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
