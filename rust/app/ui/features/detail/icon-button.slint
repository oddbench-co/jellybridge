import { Theme } from "../../theme.slint";

// Round icon action button (play, replay, watched, favorite, info, ...).
export component DetailIconButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <length> size: 44px;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.primary
        ? (icon-touch.has-hover ? Theme.accent-bright : Theme.accent)
        : root.active
            ? Theme.accent-deep
            : icon-touch.has-hover ? Theme.surface-hover : Theme.surface-raised;
    border-color: root.primary || root.active ? transparent : Theme.border;
    border-width: 1px;
    opacity: root.enabled ? 1.0 : 0.45;

    Text {
        text: root.glyph;
        color: root.primary ? Theme.bg : root.active ? Theme.text-bright : Theme.text-secondary;
        font-size: root.size * 0.43;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    icon-touch := TouchArea {
        mouse-cursor: pointer;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
