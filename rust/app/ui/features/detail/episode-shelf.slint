import { Theme } from "../../theme.slint";
import { DetailCard } from "../../types.slint";
import { ShelfScrollArea } from "../../components/shelf-scroll-area.slint";

// "More from Season N": wide thumbnail cards for an episode's siblings,
// with the currently open episode highlighted.
export component EpisodeShelf inherits Rectangle {
    in property <[DetailCard]> episodes;
    in property <string> heading: "More from this season";
    in property <string> current-id;
    callback open(id: string, kind: string);

    property <length> card-width: 264px;
    property <length> card-height: root.card-width * 9 / 16;
    property <length> content-width: max(0px, root.episodes.length * (root.card-width + 16px) - 16px);
    property <length> viewport-width: min(root.width - 96px, 1400px);
    property <length> viewport-x: (root.width - root.viewport-width) / 2;
    property <length> minimum-offset: min(0px, root.viewport-width - root.content-width);
    property <length> offset-x: 0px;
    animate offset-x { duration: 120ms; easing: ease-out; }

    height: root.card-height + 116px;
    background: Theme.bg;

    Text {
        x: root.viewport-x;
        y: 14px;
        text: root.heading;
        color: Theme.text-primary;
        font-size: 21px;
        font-weight: 750;
    }

    episode-viewport := Rectangle {
        x: root.viewport-x;
        y: 52px;
        width: root.viewport-width;
        height: parent.height - 60px;
        clip: true;

        ShelfScrollArea {
            width: 100%;
            height: 100%;
            viewport-width: root.viewport-width;
            content-width: root.content-width;
            minimum-offset: root.minimum-offset;
            offset-x <=> root.offset-x;
        }

        HorizontalLayout {
            x: root.offset-x;
            width: root.content-width;
            spacing: 16px;
            for episode in root.episodes: Rectangle {
                width: root.card-width;
                background: transparent;

                VerticalLayout {
                    spacing: 7px;
                    Rectangle {
                        height: root.card-height;
                        background: Theme.surface;
                        border-radius: Theme.radius-medium;
                        border-color: episode.id == root.current-id
                            ? Theme.accent
                            : episode-touch.has-hover ? Theme.border-strong : Theme.surface-hover;
                        border-width: episode.id == root.current-id ? 3px : episode-touch.has-hover ? 2px : 1px;
                        clip: true;
                        drop-shadow-color: Theme.scrim.with-alpha(0.44);
                        drop-shadow-blur: 8px;
                        drop-shadow-offset-y: 3px;

                        Text {
                            text: episode.title;
                            color: Theme.border-strong;
                            font-size: 13px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Image { source: episode.artwork; width: 100%; height: 100%; image-fit: cover; }

                        if episode.watched: Rectangle {
                            x: parent.width - 33px;
                            y: 8px;
                            width: 25px;
                            height: 25px;
                            border-radius: Theme.radius-large;
                            background: Theme.accent;
                            Text { text: "✓"; color: white; font-size: 14px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                        }

                        if episode.progress > 0 && episode.progress < 1: Rectangle {
                            x: 0px;
                            y: parent.height - 5px;
                            width: parent.width;
                            height: 5px;
                            background: Theme.overlay;
                            Rectangle {
                                x: 0px;
                                width: parent.width * episode.progress;
                                height: 100%;
                                background: Theme.accent;
                            }
                        }

                        episode-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open(episode.id, episode.kind); }
                        }
                    }
                    Text {
                        text: episode.title;
                        color: episode.id == root.current-id ? Theme.text-primary : Theme.text-secondary;
                        font-size: 12px;
                        font-weight: episode.id == root.current-id ? 700 : 500;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
