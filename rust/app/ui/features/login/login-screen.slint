import { Button, LineEdit } from "std-widgets.slint";
import { Theme } from "../../theme.slint";

export component LoginScreen inherits Rectangle {
    in property <bool> busy: false;
    in property <string> message: "";

    callback login(server: string, username: string, password: string);

    background: @linear-gradient(180deg, Theme.bg 0%, Theme.surface-dim 100%);

    Rectangle {
        width: min(parent.width - 48px, 860px);
        height: 430px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: Theme.radius-large;
        drop-shadow-color: Theme.scrim.with-alpha(0.5);
        drop-shadow-blur: 24px;

        HorizontalLayout {
            padding: 38px;
            spacing: 40px;

            VerticalLayout {
                width: 42%;
                alignment: center;
                spacing: 12px;

                Rectangle {
                    width: 62px;
                    height: 62px;
                    border-radius: Theme.radius-large;
                    background: Theme.accent-surface;
                    Image {
                        source: @image-url("../../../assets/icon.png");
                        width: 100%;
                        height: 100%;
                        image-fit: contain;
                    }
                }
                Text {
                    text: "JellyBridge";
                    color: Theme.accent;
                    font-size: 36px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Native Jellyfin playback with MPV";
                    color: Theme.text-muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }

            Rectangle {
                width: 1px;
                background: Theme.border;
            }

            VerticalLayout {
                spacing: 13px;
                vertical-stretch: 1;

                Text {
                    text: "Sign in";
                    color: Theme.text-primary;
                    font-size: 25px;
                    font-weight: 700;
                }
                Text { text: "Server URL"; color: Theme.text-muted; font-size: 12px; }
                server-input := LineEdit {
                    text: "http://";
                    enabled: !root.busy;
                    placeholder-text: "http://jellyfin.local:8096";
                }
                Text { text: "Username"; color: Theme.text-muted; font-size: 12px; }
                username-input := LineEdit {
                    enabled: !root.busy;
                    placeholder-text: "Jellyfin username";
                }
                Text { text: "Password"; color: Theme.text-muted; font-size: 12px; }
                password-input := LineEdit {
                    enabled: !root.busy;
                    input-type: password;
                    placeholder-text: "Password";
                    accepted => {
                        root.login(server-input.text, username-input.text, self.text);
                    }
                }
                Text {
                    text: root.message;
                    color: Theme.danger-text;
                    font-size: 12px;
                    wrap: word-wrap;
                    visible: root.message != "";
                }
                Button {
                    text: root.busy ? "Connecting…" : "Connect";
                    enabled: !root.busy && server-input.text != "" && username-input.text != "";
                    clicked => {
                        root.login(server-input.text, username-input.text, password-input.text);
                    }
                }
            }
        }
    }
}
