import { Spinner } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { ChapterMarker } from "../../types.slint";
import { Icons } from "../../components/icons.slint";
import { PlayerIcon, PlayerIconButton } from "player-icon-button.slint";
import { PlayerMenu } from "player-menu.slint";
import { PlayerTimeline } from "player-timeline.slint";

// Which pop-up menu is open. Settings drills into speed and aspect.
enum PlayerMenuKind { none, audio, subtitles, settings, speed, aspect }

// Jellyfin-style player: video under a top scrim (back, title) and a bottom
// scrim (seek bar, transport, volume, menus). The chrome fades out when idle;
// the skip-segment button and Up Next card float above it.
export component PlayerScreen inherits Rectangle {
    in property <image> video-frame;
    in property <string> title;
    in property <string> subtitle;
    in property <string> player-status;
    in property <string> decode-label;
    in property <bool> paused;
    in property <bool> muted;
    in property <bool> loading;
    in property <bool> buffering;
    in property <bool> fullscreen-player;
    in property <bool> controls-visible;
    in property <string> playback-position-label;
    in property <string> playback-duration-label;
    in property <string> ends-at-label;
    in property <float> playback-duration;
    in property <[ChapterMarker]> chapters;
    in property <[string]> audio-options;
    in property <[string]> subtitle-options;
    in property <bool> has-previous;
    in property <bool> has-next;
    in property <string> skip-label;
    in property <float> skip-target;
    in property <bool> up-next-visible;
    in property <string> up-next-title;
    in property <string> up-next-subtitle;
    in property <int> up-next-countdown;
    in-out property <int> audio-index;
    in-out property <int> subtitle-index;
    in-out property <int> speed-index;
    in-out property <int> aspect-index;
    in-out property <float> volume;
    // Owned by the window, which synchronizes them with player events and
    // enter-player; the timeline edits them while scrubbing.
    in-out property <float> timeline-position;
    in-out property <bool> timeline-scrubbing;

    // Read by the idle timer in Rust: the chrome stays up while either holds.
    out property <bool> menu-open: root.open-menu != PlayerMenuKind.none;
    out property <bool> chrome-hovered: top-touch.has-hover || bottom-touch.has-hover;

    callback toggle-playback();
    callback toggle-mute();
    callback toggle-fullscreen();
    callback seek-relative(seconds: float);
    callback seek-absolute(seconds: float);
    callback scrub-finished(seconds: float);
    callback select-audio(index: int);
    callback select-subtitle(index: int);
    callback set-speed(index: int);
    callback set-aspect(index: int);
    callback volume-changed(volume: float);
    callback play-previous();
    callback play-next();
    callback dismiss-up-next();
    callback player-activity();
    callback leave-player();
    pure callback chapter-title-at(float) -> string;

    // Test probes: the proportion actually drawn on the timeline, and where
    // the timeline sits, asserted by window tests.
    out property <float> probe-played-ratio: timeline.played-ratio;
    out property <length> probe-timeline-y: timeline.absolute-position.y + timeline.height / 2;

    private property <PlayerMenuKind> open-menu: PlayerMenuKind.none;
    private property <[string]> speed-options: ["0.5x", "0.75x", "Normal", "1.25x", "1.5x", "1.75x", "2x"];
    private property <[string]> aspect-options: ["Auto", "Cover", "Fill"];
    private property <float> chrome-opacity: root.controls-visible || root.menu-open ? 1 : 0;
    private property <length> bottom-height: 150px;

    background: Theme.scrim;

    player-surface := Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.video-bg;
        clip: true;

        Image {
            source: root.video-frame;
            width: 100%;
            height: 100%;
            image-fit: contain;
        }

        single-click-timer := Timer {
            running: false;
            interval: 220ms;
            triggered => {
                single-click-timer.stop();
                root.toggle-playback();
            }
        }

        player-pointer := TouchArea {
            mouse-cursor: root.controls-visible ? default : none;
            // `moved` only fires while a button is pressed; hover movement
            // arrives as pointer-event move, which is what should reveal the
            // overlay like in other players.
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.player-activity();
                }
            }
            clicked => {
                root.player-activity();
                single-click-timer.start();
            }
            double-clicked => {
                single-click-timer.stop();
                root.player-activity();
                root.toggle-fullscreen();
            }
        }
    }

    if root.loading || root.buffering: Spinner {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 64px;
        height: 64px;
        indeterminate: true;
    }

    // Top chrome: back and the title lines.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 120px;
        opacity: root.chrome-opacity;
        visible: self.opacity > 0.01;
        animate opacity { duration: 220ms; easing: ease-out; }
        background: @linear-gradient(180deg, Theme.scrim.with-alpha(0.75) 0%, Theme.scrim.with-alpha(0) 100%);

        // Hovering the chrome holds it up, and clicks on its empty background
        // don't fall through to the video surface (where they would toggle
        // playback).
        top-touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.player-activity();
                }
            }
        }

        HorizontalLayout {
            y: 0px;
            height: 84px;
            padding-left: 16px;
            padding-right: 24px;
            spacing: 12px;
            alignment: start;

            Rectangle {
                width: back-button.width;
                back-button := PlayerIconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.arrow-back;
                    label: "Back";
                    clicked => {
                        root.player-activity();
                        root.leave-player();
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.title;
                    color: Theme.text-bright;
                    font-size: Theme.font-heading;
                    font-weight: 700;
                    overflow: elide;
                }
                if root.subtitle != "": Text {
                    text: root.subtitle;
                    color: Theme.text-secondary;
                    font-size: Theme.font-body-large;
                    overflow: elide;
                }
                if root.player-status != "": Text {
                    text: root.player-status;
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                    overflow: elide;
                }
            }
        }
    }

    // Bottom chrome: seek bar over the transport and option buttons.
    Rectangle {
        x: 0px;
        y: parent.height - self.height;
        width: parent.width;
        height: root.bottom-height;
        opacity: root.chrome-opacity;
        visible: self.opacity > 0.01;
        animate opacity { duration: 220ms; easing: ease-out; }
        background: @linear-gradient(180deg, Theme.scrim.with-alpha(0) 0%, Theme.scrim.with-alpha(0.85) 100%);

        bottom-touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.player-activity();
                }
            }
        }

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-bottom: 14px;
            spacing: 4px;
            alignment: end;

            timeline := PlayerTimeline {
                duration: root.playback-duration;
                chapters: root.chapters;
                position <=> root.timeline-position;
                scrubbing <=> root.timeline-scrubbing;
                chapter-title-at(time) => { return root.chapter-title-at(time); }
                activity => { root.player-activity(); }
                scrub-finished(seconds) => { root.scrub-finished(seconds); }
                seek(seconds) => { root.seek-absolute(seconds); }
            }

            HorizontalLayout {
                height: 56px;
                spacing: 2px;

                if root.has-previous: Rectangle {
                    width: previous-button.width;
                    previous-button := PlayerIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.skip-previous;
                        label: "Previous";
                        clicked => { root.player-activity(); root.play-previous(); }
                    }
                }
                Rectangle {
                    width: rewind-button.width;
                    rewind-button := PlayerIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.replay;
                        badge: "10";
                        icon-size: 32px;
                        label: "Rewind 10 seconds";
                        clicked => { root.player-activity(); root.seek-relative(-10); }
                    }
                }
                Rectangle {
                    width: play-button.width;
                    play-button := PlayerIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: root.paused ? Icons.play : Icons.pause;
                        icon-size: 36px;
                        label: root.paused ? "Play" : "Pause";
                        clicked => { root.player-activity(); root.toggle-playback(); }
                    }
                }
                Rectangle {
                    width: forward-button.width;
                    forward-button := PlayerIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.forward;
                        badge: "30";
                        icon-size: 32px;
                        label: "Fast forward 30 seconds";
                        clicked => { root.player-activity(); root.seek-relative(30); }
                    }
                }
                if root.has-next: Rectangle {
                    width: next-button.width;
                    next-button := PlayerIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.skip-next;
                        label: "Next";
                        clicked => { root.player-activity(); root.play-next(); }
                    }
                }

                Text {
                    text: root.playback-position-label + " / " + root.playback-duration-label;
                    color: Theme.text-primary;
                    font-size: Theme.font-body-large;
                    vertical-alignment: center;
                    // Room between the transport and the clock.
                    width: self.preferred-width + 24px;
                    horizontal-alignment: right;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.ends-at-label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    width: self.preferred-width + 16px;
                }

                Rectangle {
                    width: mute-button.width;
                    mute-button := PlayerIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: root.muted || root.volume <= 0 ? Icons.volume-off : Icons.volume-up;
                        label: root.muted ? "Unmute" : "Mute";
                        clicked => { root.player-activity(); root.toggle-mute(); }
                    }
                }

                // Volume slider: thin rail, filled to the level, with a knob.
                volume-bar := Rectangle {
                    width: 96px;
                    property <float> shown: root.muted ? 0 : clamp(root.volume, 0, 100);
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 100%;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.text-bright.with-alpha(0.3);
                    }
                    Rectangle {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width * volume-bar.shown / 100;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.text-bright;
                    }
                    Rectangle {
                        x: clamp(parent.width * volume-bar.shown / 100 - self.width / 2, 0px, parent.width - self.width);
                        y: (parent.height - self.height) / 2;
                        width: volume-touch.has-hover || volume-touch.pressed ? 14px : 10px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: Theme.text-bright;
                    }
                    volume-touch := TouchArea {
                        mouse-cursor: pointer;
                        function apply() {
                            root.player-activity();
                            // Dragging the slider unmutes, as in Jellyfin.
                            if root.muted {
                                root.toggle-mute();
                            }
                            root.volume = Math.round(clamp(self.mouse-x / self.width, 0, 1) * 100);
                            root.volume-changed(root.volume);
                        }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                volume-touch.apply();
                            }
                            if event.kind == PointerEventKind.move && self.pressed {
                                volume-touch.apply();
                            }
                        }
                    }
                }

                Rectangle { width: 8px; }

                Rectangle {
                    width: audio-button.width;
                    audio-button := PlayerIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.audiotrack;
                        label: "Audio";
                        enabled: root.audio-options.length > 0;
                        clicked => { root.player-activity(); root.open-menu = PlayerMenuKind.audio; }
                    }
                }
                Rectangle {
                    width: subtitle-button.width;
                    subtitle-button := PlayerIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.subtitles;
                        label: "Subtitles";
                        enabled: root.subtitle-options.length > 1;
                        clicked => { root.player-activity(); root.open-menu = PlayerMenuKind.subtitles; }
                    }
                }
                Rectangle {
                    width: settings-button.width;
                    settings-button := PlayerIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.settings;
                        label: "Settings";
                        clicked => { root.player-activity(); root.open-menu = PlayerMenuKind.settings; }
                    }
                }
                Rectangle {
                    width: fullscreen-button.width;
                    fullscreen-button := PlayerIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: root.fullscreen-player ? Icons.fullscreen-exit : Icons.fullscreen;
                        label: root.fullscreen-player ? "Exit fullscreen" : "Fullscreen";
                        clicked => { root.player-activity(); root.toggle-fullscreen(); }
                    }
                }
            }
        }
    }

    // Skip Intro / Recap / Credits. Stays up while the chrome is hidden, as
    // in Jellyfin, and moves above the chrome when it shows.
    if root.skip-label != "" && !root.up-next-visible: Rectangle {
        x: parent.width - self.width - 32px;
        y: parent.height - self.height - (root.controls-visible ? root.bottom-height : 40px);
        animate y { duration: 220ms; easing: ease-out; }
        width: skip-text.preferred-width + 40px;
        height: 44px;
        border-radius: self.height / 2;
        background: skip-touch.has-hover ? Theme.text-bright : Theme.text-bright.with-alpha(0.9);
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.scrim.with-alpha(0.5);

        skip-text := Text {
            width: parent.width;
            height: parent.height;
            text: root.skip-label;
            color: Theme.bg;
            font-size: Theme.font-subtitle;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        skip-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.player-activity(); root.seek-absolute(root.skip-target); }
        }
    }

    // Up Next: the next episode, counting down to autoplay.
    if root.up-next-visible: Rectangle {
        x: parent.width - self.width - 32px;
        y: parent.height - self.height - (root.controls-visible ? root.bottom-height : 40px);
        animate y { duration: 220ms; easing: ease-out; }
        width: 340px;
        height: up-next-layout.preferred-height;
        border-radius: Theme.radius-large;
        background: Theme.overlay;
        drop-shadow-blur: 16px;
        drop-shadow-color: Theme.scrim.with-alpha(0.5);

        TouchArea { }

        up-next-layout := VerticalLayout {
            padding: 16px;
            spacing: 6px;
            Text {
                text: "Up Next";
                color: Theme.accent-bright;
                font-size: Theme.font-body;
                font-weight: 700;
            }
            Text {
                text: root.up-next-title;
                color: Theme.text-bright;
                font-size: Theme.font-title;
                font-weight: 700;
                overflow: elide;
            }
            if root.up-next-subtitle != "": Text {
                text: root.up-next-subtitle;
                color: Theme.text-secondary;
                font-size: Theme.font-body;
                overflow: elide;
            }
            Text {
                text: root.up-next-countdown > 0 ? "Starting in " + root.up-next-countdown + " s" : "Starting…";
                color: Theme.text-muted;
                font-size: Theme.font-body;
            }
            HorizontalLayout {
                padding-top: 6px;
                spacing: 8px;
                Rectangle {
                    height: 36px;
                    horizontal-stretch: 1;
                    border-radius: Theme.radius-small;
                    background: play-now-touch.has-hover ? Theme.accent-bright : Theme.accent;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: "Play now";
                        color: Theme.text-bright;
                        font-size: Theme.font-body-large;
                        font-weight: 700;
                    }
                    play-now-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.player-activity(); root.play-next(); }
                    }
                }
                Rectangle {
                    height: 36px;
                    horizontal-stretch: 1;
                    border-radius: Theme.radius-small;
                    background: hide-touch.has-hover ? Theme.surface-hover : Theme.surface-raised;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: "Hide";
                        color: Theme.text-primary;
                        font-size: Theme.font-body-large;
                    }
                    hide-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.player-activity(); root.dismiss-up-next(); }
                    }
                }
            }
        }
    }

    // Open menu: a full-size catcher closes it on any outside click.
    if root.menu-open: TouchArea {
        clicked => { root.open-menu = PlayerMenuKind.none; }
    }

    if root.open-menu == PlayerMenuKind.audio: PlayerMenu {
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - 90px;
        heading: "Audio";
        options: root.audio-options;
        selected: root.audio-index;
        picked(index) => {
            root.open-menu = PlayerMenuKind.none;
            root.audio-index = index;
            root.select-audio(index);
        }
    }

    if root.open-menu == PlayerMenuKind.subtitles: PlayerMenu {
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - 90px;
        heading: "Subtitles";
        options: root.subtitle-options;
        selected: root.subtitle-index;
        picked(index) => {
            root.open-menu = PlayerMenuKind.none;
            root.subtitle-index = index;
            root.select-subtitle(index);
        }
    }

    if root.open-menu == PlayerMenuKind.settings: PlayerMenu {
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - 90px;
        heading: "Settings";
        options: ["Playback speed", "Aspect ratio"];
        details: [root.speed-options[root.speed-index], root.aspect-options[root.aspect-index]];
        drills: true;
        footer: root.decode-label;
        picked(index) => {
            root.open-menu = index == 0 ? PlayerMenuKind.speed : PlayerMenuKind.aspect;
        }
    }

    if root.open-menu == PlayerMenuKind.speed: PlayerMenu {
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - 90px;
        heading: "Playback speed";
        options: root.speed-options;
        selected: root.speed-index;
        can-go-back: true;
        back => { root.open-menu = PlayerMenuKind.settings; }
        picked(index) => {
            root.open-menu = PlayerMenuKind.none;
            root.speed-index = index;
            root.set-speed(index);
        }
    }

    if root.open-menu == PlayerMenuKind.aspect: PlayerMenu {
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - 90px;
        heading: "Aspect ratio";
        options: root.aspect-options;
        selected: root.aspect-index;
        can-go-back: true;
        back => { root.open-menu = PlayerMenuKind.settings; }
        picked(index) => {
            root.open-menu = PlayerMenuKind.none;
            root.aspect-index = index;
            root.set-aspect(index);
        }
    }
}
