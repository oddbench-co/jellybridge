import { Button, ComboBox, Slider } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { ChapterMarker } from "../../types.slint";

export component PlayerScreen inherits Rectangle {
    in property <image> video-frame;
    in property <string> title;
    in property <string> player-status;
    in property <bool> paused;
    in property <bool> fullscreen-player;
    in property <bool> controls-visible;
    in property <string> playback-position-label;
    in property <string> playback-duration-label;
    in property <float> playback-duration;
    in property <[ChapterMarker]> chapters;
    in property <[string]> audio-options;
    in property <[string]> subtitle-options;
    in-out property <int> audio-index;
    in-out property <int> subtitle-index;
    in-out property <float> volume;
    // Owned by the window, which synchronizes them with player events and
    // enter-player; the timeline edits them while scrubbing.
    in-out property <float> timeline-position;
    in-out property <bool> timeline-scrubbing;

    callback toggle-playback();
    callback toggle-fullscreen();
    callback seek-relative(seconds: float);
    callback seek-absolute(seconds: float);
    callback scrub-finished(seconds: float);
    callback select-audio(index: int);
    callback select-subtitle(index: int);
    callback volume-changed(volume: float);
    callback player-activity();
    callback leave-player();

    background: Theme.scrim;

    player-surface := Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.video-bg;
        clip: true;

        Image {
            source: root.video-frame;
            width: 100%;
            height: 100%;
            image-fit: contain;
        }

        single-click-timer := Timer {
            running: false;
            interval: 220ms;
            triggered => {
                single-click-timer.stop();
                root.toggle-playback();
            }
        }

        player-pointer := TouchArea {
            mouse-cursor: root.fullscreen-player && !root.controls-visible ? none : default;
            // `moved` only fires while a button is pressed; hover movement
            // arrives as pointer-event move, which is what should reveal the
            // overlay like in other players.
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.player-activity();
                }
            }
            clicked => {
                root.player-activity();
                single-click-timer.start();
            }
            double-clicked => {
                single-click-timer.stop();
                root.player-activity();
                root.toggle-fullscreen();
            }
        }
    }

    Rectangle {
        visible: !root.fullscreen-player || root.controls-visible;
        x: root.fullscreen-player ? 24px : 0px;
        y: root.fullscreen-player ? 24px : 0px;
        width: root.fullscreen-player ? parent.width - 48px : parent.width;
        height: 64px;
        border-radius: root.fullscreen-player ? 10px : 0px;
        background: Theme.bg.with-alpha(0.91);

        // Hovering the bar counts as activity so the overlay stays up, and
        // clicks on its empty background don't fall through to the video
        // surface (where they would toggle playback).
        TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.player-activity();
                }
            }
        }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 12px;
            Button {
                text: "‹ Back";
                clicked => { root.player-activity(); root.leave-player(); }
            }
            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: 19px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.player-status;
                color: Theme.text-muted;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }

    Rectangle {
        visible: !root.fullscreen-player || root.controls-visible;
        x: root.fullscreen-player ? 24px : 0px;
        y: parent.height - self.height - (root.fullscreen-player ? 24px : 0px);
        width: root.fullscreen-player ? parent.width - 48px : parent.width;
        height: 158px;
        border-radius: root.fullscreen-player ? 10px : 0px;
        background: Theme.bg.with-alpha(0.93);

        TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.player-activity();
                }
            }
        }

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.playback-position-label;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                timeline-area := Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;

                    // Time under the cursor, derived from the hover position.
                    property <float> hover-ratio: clamp(timeline-touch.mouse-x / max(self.width, 1px), 0, 1);
                    property <float> hover-time: self.hover-ratio * max(root.playback-duration, 1);
                    property <int> hover-total: Math.round(self.hover-time);
                    property <int> hover-hours: Math.floor(self.hover-total / 3600);
                    property <int> hover-minutes: Math.floor(Math.mod(self.hover-total, 3600) / 60);
                    property <int> hover-secs: Math.mod(self.hover-total, 60);
                    property <string> hover-label:
                        (self.hover-hours > 0 ? self.hover-hours + ":" + (self.hover-minutes < 10 ? "0" : "") : "")
                        + self.hover-minutes + ":"
                        + (self.hover-secs < 10 ? "0" : "") + self.hover-secs;

                    player-timeline := Slider {
                        width: 100%;
                        height: 100%;
                        minimum: 0;
                        maximum: max(root.playback-duration, 1);
                        value <=> root.timeline-position;
                    }

                    // Chapter marks, like mpv's seekbar ticks. Positions are
                    // bindings, so they follow the duration when mpv reports
                    // it after the chapter list.
                    for chapter in root.chapters: Rectangle {
                        x: chapter.time / max(root.playback-duration, 1) * parent.width - self.width / 2;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: 8px;
                        border-radius: 1px;
                        background: Theme.text-bright.with-alpha(0.55);
                        visible: chapter.time > 0 && chapter.time < root.playback-duration;
                    }

                    // Owns all pointer interaction with the timeline: the
                    // stock Slider exposes no hover position, so this layer
                    // provides the finger cursor and hover time, and drives
                    // scrubbing through the same timeline-position /
                    // scrub-finished path the Slider's handlers used.
                    timeline-touch := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.move {
                                root.player-activity();
                                if self.pressed {
                                    root.timeline-position = timeline-area.hover-time;
                                }
                            }
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                root.timeline-scrubbing = true;
                                root.timeline-position = timeline-area.hover-time;
                            }
                            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                                root.player-activity();
                                root.scrub-finished(root.timeline-position);
                                root.seek-absolute(root.timeline-position);
                            }
                        }
                    }

                    hover-tooltip := Rectangle {
                        x: clamp(timeline-touch.mouse-x - self.width / 2, 0px, parent.width - self.width);
                        y: -30px;
                        width: hover-text.preferred-width + 14px;
                        height: 24px;
                        border-radius: Theme.radius-small;
                        background: Theme.overlay-raised;
                        border-color: Theme.border;
                        border-width: 1px;
                        visible: timeline-touch.has-hover || timeline-touch.pressed;

                        hover-text := Text {
                            text: timeline-area.hover-label;
                            color: Theme.text-primary;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    text: root.playback-duration-label;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: root.paused ? "Play" : "Pause";
                    clicked => { root.player-activity(); root.toggle-playback(); }
                }
                Button {
                    text: "−10 s";
                    clicked => { root.player-activity(); root.seek-relative(-10); }
                }
                Button {
                    text: "+10 s";
                    clicked => { root.player-activity(); root.seek-relative(10); }
                }
                Text { text: "Audio"; color: Theme.text-secondary; vertical-alignment: center; }
                audio-combo := ComboBox {
                    width: 180px;
                    model: root.audio-options;
                    current-index: root.audio-index;
                    enabled: root.audio-options.length > 0;
                    selected(_) => {
                        root.player-activity();
                        root.select-audio(self.current-index);
                    }
                }
                Text { text: "Subtitles"; color: Theme.text-secondary; vertical-alignment: center; }
                subtitle-combo := ComboBox {
                    width: 180px;
                    model: root.subtitle-options;
                    current-index: root.subtitle-index;
                    enabled: root.subtitle-options.length > 0;
                    selected(_) => {
                        root.player-activity();
                        root.select-subtitle(self.current-index);
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Volume"; color: Theme.text-secondary; vertical-alignment: center; }
                Slider {
                    minimum: 0;
                    maximum: 100;
                    value: root.volume;
                    width: 150px;
                    changed(value) => {
                        root.player-activity();
                        root.volume = value;
                        root.volume-changed(value);
                    }
                }
                Button {
                    text: root.fullscreen-player ? "Exit Fullscreen" : "Fullscreen";
                    clicked => { root.player-activity(); root.toggle-fullscreen(); }
                }
            }
        }
    }
}
