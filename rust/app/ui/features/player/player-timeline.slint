import { Theme } from "../../theme.slint";
import { ChapterMarker } from "../../types.slint";

// The seek bar. One mapping for the whole timeline: position, chapter marks
// and the hover/seek cursor all use ratio-of-width, so they agree with each
// other by construction. The stock Slider used to draw this, but it maps its
// value over a thumb-inset rail while everything layered on top mapped over
// the full width, so the marks and the click target drifted from the
// playhead.
export component PlayerTimeline inherits Rectangle {
    in property <float> duration;
    in property <[ChapterMarker]> chapters;
    // Owned by the window, which synchronizes it with player events and
    // enter-player; the timeline edits it while scrubbing.
    in-out property <float> position;
    in-out property <bool> scrubbing;
    out property <float> played-ratio: root.duration > 0
        ? clamp(root.position / root.duration, 0, 1)
        : 0;
    out property <bool> active: touch.has-hover || touch.pressed;

    // Name of the chapter at a time, or "" -- answered by Rust, which holds
    // the chapter list in order.
    pure callback chapter-title-at(float) -> string;
    callback activity();
    callback scrub-finished(float);
    callback seek(float);

    height: 28px;
    background: transparent;

    // Time under the cursor, derived from the hover position.
    property <float> hover-ratio: clamp(touch.mouse-x / max(self.width, 1px), 0, 1);
    property <float> hover-time: self.hover-ratio * max(root.duration, 1);
    property <int> hover-total: Math.round(self.hover-time);
    property <int> hover-hours: Math.floor(self.hover-total / 3600);
    property <int> hover-minutes: Math.floor(Math.mod(self.hover-total, 3600) / 60);
    property <int> hover-secs: Math.mod(self.hover-total, 60);
    property <string> hover-clock:
        (self.hover-hours > 0 ? self.hover-hours + ":" + (self.hover-minutes < 10 ? "0" : "") : "")
        + self.hover-minutes + ":"
        + (self.hover-secs < 10 ? "0" : "") + self.hover-secs;
    property <string> hover-chapter: root.active ? root.chapter-title-at(self.hover-time) : "";
    property <string> hover-label: self.hover-chapter != ""
        ? self.hover-chapter + "  ·  " + self.hover-clock
        : self.hover-clock;
    property <length> rail-height: root.active ? 6px : 4px;

    // Rail, then the played portion over it. The fill is a plain fraction of
    // the full width, so what is drawn is exactly played / total.
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.rail-height;
        width: 100%;
        border-radius: self.height / 2;
        background: Theme.text-bright.with-alpha(0.25);
        animate height { duration: 80ms; easing: ease-out; }
    }
    // Where the cursor would seek to, like Jellyfin's lighter hover fill.
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        height: root.rail-height;
        width: touch.has-hover ? parent.width * root.hover-ratio : 0px;
        border-radius: self.height / 2;
        background: Theme.text-bright.with-alpha(0.25);
        animate height { duration: 80ms; easing: ease-out; }
    }
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        height: root.rail-height;
        width: parent.width * root.played-ratio;
        border-radius: self.height / 2;
        background: Theme.accent;
        animate height { duration: 80ms; easing: ease-out; }
    }

    // Chapter marks. Positions are bindings, so they follow the duration
    // when mpv reports it after the chapter list.
    for chapter in root.chapters: Rectangle {
        x: chapter.time / max(root.duration, 1) * parent.width - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 2px;
        height: root.rail-height + 4px;
        border-radius: 1px;
        background: Theme.text-bright.with-alpha(0.6);
        visible: chapter.time > 0 && chapter.time < root.duration;
    }

    // Playhead. Kept inside the track at both ends, which is why it is drawn
    // from the same ratio rather than being what defines it.
    Rectangle {
        x: clamp(
            parent.width * root.played-ratio - self.width / 2,
            0px,
            parent.width - self.width
        );
        y: (parent.height - self.height) / 2;
        width: root.active ? 16px : 12px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.text-bright;
        animate width { duration: 80ms; easing: ease-out; }
    }

    // Owns all pointer interaction with the timeline: it provides the finger
    // cursor and hover time, and drives scrubbing through the position /
    // scrub-finished path.
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.activity();
                if self.pressed {
                    root.position = root.hover-time;
                }
            }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.scrubbing = true;
                root.position = root.hover-time;
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                root.activity();
                root.scrub-finished(root.position);
                root.seek(root.position);
            }
        }
    }

    Rectangle {
        x: clamp(touch.mouse-x - self.width / 2, 0px, parent.width - self.width);
        y: -34px;
        width: tooltip-text.preferred-width + 16px;
        height: 26px;
        border-radius: Theme.radius-small;
        background: Theme.overlay-raised;
        visible: root.active;

        tooltip-text := Text {
            text: root.hover-label;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
