import { Button, ComboBox, LineEdit, ListView, ScrollView, Slider } from "std-widgets.slint";
import { CatalogSection, CatalogItem, DetailCard, DetailPerson, Screen, DetailKind } from "types.slint";
import { Theme } from "theme.slint";

export { CatalogSection, CatalogItem, DetailCard, DetailPerson, Screen, DetailKind }

component DetailHero inherits Rectangle {
    in property <string> title;
    in property <string> tagline;
    in property <string> metadata;
    in property <string> overview;
    in property <string> genres;
    in property <string> studios;
    in property <string> media-info;
    in property <string> series-id;
    in property <string> series-name;
    in property <string> season-id;
    in property <string> season-name;
    in property <image> poster;
    in property <image> backdrop;
    in property <image> logo;
    in property <bool> wide-art: false;
    in property <bool> playable: false;
    in property <bool> watched: false;
    in property <bool> favorite: false;
    in property <bool> busy: false;
    in property <[string]> audio-options;
    in property <[string]> subtitle-options;
    in-out property <int> audio-index: 0;
    in-out property <int> subtitle-index: 0;
    callback play();
    callback set-watched(bool);
    callback set-favorite(bool);
    callback audio-selected(int);
    callback subtitle-selected(int);
    callback open-related(string, string);

    height: 400px;
    background: Theme.bg;
    clip: true;

    Image { source: root.backdrop; width: 100%; height: 100%; image-fit: cover; }
    Rectangle { background: @linear-gradient(90deg, Theme.bg.with-alpha(0.98) 0%, Theme.bg.with-alpha(0.85) 55%, Theme.bg.with-alpha(0.4) 100%); }
    Rectangle { background: @linear-gradient(180deg, Theme.bg.with-alpha(0.13) 0%, Theme.bg 100%); }

    HorizontalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-top: 26px;
        padding-bottom: 24px;
        spacing: 28px;

        Rectangle {
            width: root.wide-art ? 300px : 205px;
            height: root.wide-art ? 169px : 308px;
            background: Theme.surface;
            border-radius: Theme.radius-medium;
            clip: true;
            drop-shadow-color: Theme.scrim.with-alpha(0.63);
            drop-shadow-blur: 20px;
            Text { text: root.title; color: Theme.border-strong; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
            Image { source: root.poster; width: 100%; height: 100%; image-fit: cover; }
        }

        VerticalLayout {
            spacing: 9px;

            Image { source: root.logo; width: 320px; height: 74px; image-fit: contain; visible: root.logo.width > 0; }
            Text { text: root.title; color: Theme.text-bright; font-size: 34px; font-weight: 800; wrap: word-wrap; }
            Text { text: root.tagline; color: Theme.text-primary; font-size: 14px; visible: root.tagline != ""; overflow: elide; }
            Text { text: root.metadata; color: Theme.text-secondary; font-size: 13px; overflow: elide; }

            HorizontalLayout {
                height: 34px;
                spacing: 6px;
                visible: root.series-id != "" || root.season-id != "";
                Button {
                    text: root.series-name == "" ? "Series" : root.series-name;
                    visible: root.series-id != "";
                    clicked => { root.open-related(root.series-id, "Series"); }
                }
                Text {
                    text: "›";
                    color: Theme.text-faint;
                    font-size: 17px;
                    vertical-alignment: center;
                    visible: root.series-id != "" && root.season-id != "";
                }
                Button {
                    text: root.season-name == "" ? "Season" : root.season-name;
                    visible: root.season-id != "";
                    clicked => { root.open-related(root.season-id, "Season"); }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            HorizontalLayout {
                height: 42px;
                spacing: 8px;
                Button { text: "Play / Resume"; visible: root.playable; enabled: !root.busy; clicked => { root.play(); } }
                Button { text: root.watched ? "✓ Watched" : "Mark watched"; enabled: !root.busy; clicked => { root.set-watched(!root.watched); } }
                Button { text: root.favorite ? "★ Favorite" : "☆ Favorite"; enabled: !root.busy; clicked => { root.set-favorite(!root.favorite); } }
            }

            HorizontalLayout {
                height: 38px;
                spacing: 8px;
                visible: root.audio-options.length > 1 || root.subtitle-options.length > 1;
                ComboBox {
                    width: 220px;
                    model: root.audio-options;
                    current-index: root.audio-index;
                    visible: root.audio-options.length > 1;
                    selected(_) => { root.audio-index = self.current-index; root.audio-selected(self.current-index); }
                }
                ComboBox {
                    width: 220px;
                    model: root.subtitle-options;
                    current-index: root.subtitle-index;
                    visible: root.subtitle-options.length > 1;
                    selected(_) => { root.subtitle-index = self.current-index; root.subtitle-selected(self.current-index); }
                }
            }

            Text { text: root.overview == "" ? "No overview available." : root.overview; color: Theme.text-secondary; font-size: 14px; wrap: word-wrap; max-height: 82px; overflow: elide; }
            Text { text: root.genres == "" ? "" : "Genres  " + root.genres; color: Theme.text-muted; font-size: 12px; visible: root.genres != ""; overflow: elide; }
            Text { text: root.studios == "" ? "" : "Studio  " + root.studios; color: Theme.text-muted; font-size: 12px; visible: root.studios != ""; overflow: elide; }
            Text { text: root.media-info; color: Theme.text-faint; font-size: 11px; visible: root.media-info != ""; overflow: elide; }
        }
    }
}

component DetailActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 40px;
    border-radius: Theme.radius-small;
    border-width: action-focus.has-focus ? 2px : 1px;
    border-color: action-focus.has-focus ? Theme.accent-bright : root.primary ? Theme.accent : root.active ? Theme.accent-deep : Theme.border;
    background: !root.enabled ? Theme.surface-raised : action-touch.pressed ? Theme.border : root.primary ? Theme.accent : root.active ? Theme.accent-surface : action-touch.has-hover ? Theme.surface-hover : Theme.surface-raised;

    Text {
        text: root.text;
        color: root.enabled ? Theme.text-primary : Theme.text-faint;
        font-size: 13px;
        font-weight: root.primary || root.active ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    action-focus := FocusScope {
        key-pressed(event) => {
            if root.enabled && (event.text == "\n" || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    action-touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                action-focus.focus();
                root.clicked();
            }
        }
    }
}

component DetailBreadcrumbLink inherits Rectangle {
    in property <string> text;
    in property <length> width-limit: 220px;
    callback clicked();

    width: min(breadcrumb-label.preferred-width + 20px, root.width-limit);
    height: 30px;
    border-radius: Theme.radius-small;
    border-width: breadcrumb-focus.has-focus ? 2px : 0px;
    border-color: Theme.accent-bright;
    background: breadcrumb-touch.has-hover ? Theme.overlay : transparent;

    breadcrumb-label := Text {
        text: root.text;
        color: Theme.accent-bright;
        font-size: 13px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    breadcrumb-focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    breadcrumb-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            breadcrumb-focus.focus();
            root.clicked();
        }
    }
}

component SeasonDetailHeader inherits Rectangle {
    in property <string> title;
    in property <string> metadata;
    in property <string> summary;
    in property <string> overview;
    in property <string> series-id;
    in property <string> series-name;
    in property <image> poster;
    in property <image> backdrop;
    in property <string> play-label;
    in property <bool> playable: false;
    in property <bool> watched: false;
    in property <bool> favorite: false;
    in property <bool> busy: false;
    callback play();
    callback set-watched(bool);
    callback set-favorite(bool);
    callback open-series(string);

    height: 300px;
    background: Theme.bg;
    clip: true;

    Image { source: root.backdrop; width: 100%; height: 100%; image-fit: cover; }
    Rectangle { background: @linear-gradient(90deg, Theme.bg.with-alpha(0.99) 0%, Theme.bg.with-alpha(0.86) 58%, Theme.bg.with-alpha(0.46) 100%); }
    Rectangle { background: @linear-gradient(180deg, Theme.bg.with-alpha(0.16) 0%, Theme.bg 100%); }

    content := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 24px;
        width: min(parent.width - 56px, 1180px);
        height: 248px;

        HorizontalLayout {
            spacing: 24px;

            Rectangle {
                width: 144px;
                height: 216px;
                background: Theme.surface;
                border-radius: Theme.radius-medium;
                border-color: Theme.border;
                border-width: 1px;
                clip: true;
                drop-shadow-color: Theme.scrim.with-alpha(0.56);
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 5px;

                Text {
                    text: root.title;
                    color: Theme.border-strong;
                    font-size: 14px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Image { source: root.poster; width: 100%; height: 100%; image-fit: cover; }
            }

            VerticalLayout {
                spacing: 7px;

                HorizontalLayout {
                    height: 30px;
                    spacing: 5px;
                    DetailBreadcrumbLink {
                        text: root.series-name == "" ? "Series" : root.series-name;
                        visible: root.series-id != "";
                        clicked => { root.open-series(root.series-id); }
                    }
                    Text {
                        text: "›";
                        color: Theme.text-faint;
                        font-size: 17px;
                        vertical-alignment: center;
                        visible: root.series-id != "";
                    }
                    Text {
                        text: root.title;
                        color: Theme.text-muted;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                Text {
                    text: root.title;
                    color: Theme.text-bright;
                    font-size: 31px;
                    font-weight: 800;
                    overflow: elide;
                }
                Text {
                    text: root.metadata;
                    color: Theme.text-secondary;
                    font-size: 13px;
                    visible: root.metadata != "";
                    overflow: elide;
                }
                Text {
                    text: root.summary;
                    color: Theme.accent-bright;
                    font-size: 13px;
                    font-weight: 650;
                    overflow: elide;
                }
                Text {
                    text: root.overview == "" ? "No season overview available." : root.overview;
                    color: Theme.text-secondary;
                    font-size: 13px;
                    wrap: word-wrap;
                    max-height: 50px;
                    overflow: elide;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    height: 40px;
                    spacing: 9px;
                    DetailActionButton {
                        width: 118px;
                        text: root.play-label == "" ? "Play" : root.play-label;
                        primary: true;
                        visible: root.playable;
                        enabled: !root.busy;
                        clicked => { root.play(); }
                    }
                    DetailActionButton {
                        width: 142px;
                        text: root.watched ? "✓ Watched" : "Mark watched";
                        active: root.watched;
                        enabled: !root.busy;
                        clicked => { root.set-watched(!root.watched); }
                    }
                    DetailActionButton {
                        width: 132px;
                        text: root.favorite ? "★ Favorite" : "☆ Favorite";
                        active: root.favorite;
                        enabled: !root.busy;
                        clicked => { root.set-favorite(!root.favorite); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}

component SeriesDetailHeader inherits Rectangle {
    in property <string> title;
    in property <string> tagline;
    in property <string> metadata;
    in property <string> summary;
    in property <string> play-context;
    in property <float> progress: 0;
    in property <image> poster;
    in property <image> backdrop;
    in property <string> play-label;
    in property <bool> playable: false;
    in property <bool> watched: false;
    in property <bool> favorite: false;
    in property <bool> busy: false;
    callback play();
    callback set-watched(bool);
    callback set-favorite(bool);

    height: 300px;
    background: Theme.bg;
    clip: true;

    Image { source: root.backdrop; width: 100%; height: 100%; image-fit: cover; }
    Rectangle { background: @linear-gradient(90deg, Theme.bg.with-alpha(0.99) 0%, Theme.bg.with-alpha(0.86) 58%, Theme.bg.with-alpha(0.46) 100%); }
    Rectangle { background: @linear-gradient(180deg, Theme.bg.with-alpha(0.16) 0%, Theme.bg 100%); }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 24px;
        width: min(parent.width - 56px, 1180px);
        height: 248px;

        HorizontalLayout {
            spacing: 24px;

            Rectangle {
                width: 144px;
                height: 216px;
                background: @linear-gradient(145deg, Theme.surface-hover 0%, Theme.bg 100%);
                border-radius: Theme.radius-medium;
                border-color: Theme.border;
                border-width: 1px;
                clip: true;
                drop-shadow-color: Theme.scrim.with-alpha(0.56);
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 5px;

                Text {
                    text: root.title;
                    color: Theme.border-strong;
                    font-size: 14px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Image { source: root.poster; width: 100%; height: 100%; image-fit: cover; }
            }

            VerticalLayout {
                spacing: 7px;

                Text {
                    text: root.title;
                    color: Theme.text-bright;
                    font-size: 31px;
                    font-weight: 800;
                    wrap: word-wrap;
                    max-height: 68px;
                    overflow: elide;
                }
                Text {
                    text: root.tagline;
                    color: Theme.text-secondary;
                    font-size: 13px;
                    visible: root.tagline != "";
                    overflow: elide;
                }
                Text {
                    text: root.metadata;
                    color: Theme.text-secondary;
                    font-size: 13px;
                    visible: root.metadata != "";
                    overflow: elide;
                }
                Text {
                    text: root.summary;
                    color: Theme.accent-bright;
                    font-size: 13px;
                    font-weight: 650;
                    overflow: elide;
                }
                HorizontalLayout {
                    height: 22px;
                    spacing: 10px;
                    visible: root.play-context != "";
                    Text {
                        width: 190px;
                        text: root.play-context;
                        color: Theme.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        height: 5px;
                        background: Theme.surface-hover;
                        border-radius: 2px;
                        vertical-stretch: 0;
                        visible: root.progress > 0 && root.progress < 1;
                        Rectangle {
                            x: 0px;
                            width: parent.width * root.progress;
                            height: 100%;
                            background: Theme.accent;
                            border-radius: 2px;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    height: 40px;
                    spacing: 9px;
                    DetailActionButton {
                        width: 118px;
                        text: root.play-label == "" ? "Play" : root.play-label;
                        primary: true;
                        visible: root.playable;
                        enabled: !root.busy;
                        clicked => { root.play(); }
                    }
                    DetailActionButton {
                        width: 142px;
                        text: root.watched ? "✓ Watched" : "Mark watched";
                        active: root.watched;
                        enabled: !root.busy;
                        clicked => { root.set-watched(!root.watched); }
                    }
                    DetailActionButton {
                        width: 132px;
                        text: root.favorite ? "★ Favorite" : "☆ Favorite";
                        active: root.favorite;
                        enabled: !root.busy;
                        clicked => { root.set-favorite(!root.favorite); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}

component DetailTrackSelector inherits Rectangle {
    in property <string> label;
    in property <[string]> options;
    in-out property <int> selected-index: 0;
    callback selected(int);

    height: 40px;
    background: Theme.overlay-dim;
    border-color: Theme.surface-hover;
    border-width: 1px;
    border-radius: Theme.radius-small;

    Text {
        x: 10px;
        y: 0px;
        width: 62px;
        height: parent.height;
        text: root.label;
        color: Theme.text-faint;
        font-size: 10px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    ComboBox {
        x: 70px;
        y: 5px;
        width: parent.width - 76px;
        height: 30px;
        model: root.options;
        current-index: root.selected-index;
        selected(_) => {
            root.selected-index = self.current-index;
            root.selected(self.current-index);
        }
    }
}

component MediaDetailHeader inherits Rectangle {
    in property <string> title;
    in property <string> tagline;
    in property <string> metadata;
    in property <string> series-id;
    in property <string> series-name;
    in property <string> season-id;
    in property <string> season-name;
    in property <image> artwork;
    in property <image> backdrop;
    in property <bool> episode: false;
    in property <string> play-label;
    in property <float> progress: 0;
    in property <string> progress-label;
    in property <bool> playable: false;
    in property <bool> watched: false;
    in property <bool> favorite: false;
    in property <bool> busy: false;
    in property <[string]> audio-options;
    in property <[string]> subtitle-options;
    in-out property <int> audio-index: 0;
    in-out property <int> subtitle-index: 0;
    property <bool> has-track-options: root.audio-options.length > 1 || root.subtitle-options.length > 1;
    property <int> track-option-count: (root.audio-options.length > 1 ? 1 : 0) + (root.subtitle-options.length > 1 ? 1 : 0);
    property <length> track-column-width: min(root.width - 56px, 1180px) - (root.episode ? 304px : 168px);
    property <length> track-card-width: root.track-option-count == 1
        ? min(240px, root.track-column-width)
        : min(225px, (root.track-column-width - 8px) / 2);
    callback play();
    callback set-watched(bool);
    callback set-favorite(bool);
    callback audio-selected(int);
    callback subtitle-selected(int);
    callback open-related(string, string);

    height: root.has-track-options ? 350px : 300px;
    background: Theme.bg;
    clip: true;

    Image { source: root.backdrop; width: 100%; height: 100%; image-fit: cover; }
    Rectangle { background: @linear-gradient(90deg, Theme.bg.with-alpha(0.99) 0%, Theme.bg.with-alpha(0.89) 58%, Theme.bg.with-alpha(0.48) 100%); }
    Rectangle { background: @linear-gradient(180deg, Theme.bg.with-alpha(0.14) 0%, Theme.bg 100%); }

    media-content := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 24px;
        width: min(parent.width - 56px, 1180px);
        height: root.has-track-options ? 302px : 252px;

        HorizontalLayout {
            spacing: 24px;

            Rectangle {
                width: root.episode ? 280px : 144px;
                height: root.episode ? 158px : 216px;
                background: @linear-gradient(145deg, Theme.surface-hover 0%, Theme.bg 100%);
                border-radius: Theme.radius-medium;
                border-color: Theme.border;
                border-width: 1px;
                clip: true;
                drop-shadow-color: Theme.scrim.with-alpha(0.56);
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 5px;

                Text {
                    text: root.title;
                    color: Theme.border-strong;
                    font-size: 14px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Image { source: root.artwork; width: 100%; height: 100%; image-fit: cover; }
            }

            VerticalLayout {
                spacing: 7px;

                HorizontalLayout {
                    height: 30px;
                    spacing: 5px;
                    visible: root.episode && (root.series-id != "" || root.season-id != "");
                    DetailBreadcrumbLink {
                        text: root.series-name == "" ? "Series" : root.series-name;
                        width-limit: 180px;
                        visible: root.series-id != "";
                        clicked => { root.open-related(root.series-id, "Series"); }
                    }
                    Text {
                        text: "›";
                        color: Theme.text-faint;
                        font-size: 17px;
                        vertical-alignment: center;
                        visible: root.series-id != "" && root.season-id != "";
                    }
                    DetailBreadcrumbLink {
                        text: root.season-name == "" ? "Season" : root.season-name;
                        width-limit: 140px;
                        visible: root.season-id != "";
                        clicked => { root.open-related(root.season-id, "Season"); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                Text {
                    text: root.title;
                    color: Theme.text-bright;
                    font-size: 31px;
                    font-weight: 800;
                    wrap: word-wrap;
                    max-height: 68px;
                    overflow: elide;
                }
                Text {
                    text: root.tagline;
                    color: Theme.text-secondary;
                    font-size: 13px;
                    visible: root.tagline != "";
                    overflow: elide;
                }
                Text {
                    text: root.metadata;
                    color: Theme.accent-bright;
                    font-size: 13px;
                    font-weight: 600;
                    visible: root.metadata != "";
                    overflow: elide;
                }
                HorizontalLayout {
                    height: 20px;
                    spacing: 10px;
                    visible: root.progress-label != "" && root.progress > 0 && root.progress < 1;
                    Text {
                        width: 118px;
                        text: root.progress-label;
                        color: Theme.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        height: 5px;
                        background: Theme.surface-hover;
                        border-radius: 2px;
                        vertical-stretch: 0;
                        Rectangle {
                            x: 0px;
                            width: parent.width * root.progress;
                            height: 100%;
                            background: Theme.accent;
                            border-radius: 2px;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    height: 40px;
                    spacing: 9px;
                    DetailActionButton {
                        width: root.episode ? 104px : 118px;
                        text: root.play-label == "" ? "Play" : root.play-label;
                        primary: true;
                        visible: root.playable;
                        enabled: !root.busy;
                        clicked => { root.play(); }
                    }
                    DetailActionButton {
                        width: root.episode ? 128px : 142px;
                        text: root.watched ? "✓ Watched" : "Mark watched";
                        active: root.watched;
                        enabled: !root.busy;
                        clicked => { root.set-watched(!root.watched); }
                    }
                    DetailActionButton {
                        width: root.episode ? 118px : 132px;
                        text: root.favorite ? "★ Favorite" : "☆ Favorite";
                        active: root.favorite;
                        enabled: !root.busy;
                        clicked => { root.set-favorite(!root.favorite); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    height: 40px;
                    spacing: 8px;
                    visible: root.has-track-options;

                    DetailTrackSelector {
                        width: root.track-card-width;
                        label: "Audio";
                        options: root.audio-options;
                        selected-index <=> root.audio-index;
                        visible: root.audio-options.length > 1;
                        selected(index) => { root.audio-selected(index); }
                    }
                    DetailTrackSelector {
                        width: root.track-card-width;
                        label: "Subtitles";
                        options: root.subtitle-options;
                        selected-index <=> root.subtitle-index;
                        visible: root.subtitle-options.length > 1;
                        selected(index) => { root.subtitle-selected(index); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}

component MediaInformationSection inherits Rectangle {
    in property <string> overview;
    in property <string> genres;
    in property <string> studios;
    in property <string> media-info;
    property <bool> narrow: root.width < 900px;
    property <length> overview-width: root.narrow
        ? root.width - 56px
        : min(root.width - 56px, 1180px) - 329px;

    height: root.narrow
        ? max(310px, overview-measure.preferred-height + 218px)
        : max(220px, overview-measure.preferred-height + 88px);
    background: Theme.bg;

    overview-measure := Text {
        width: root.overview-width;
        text: root.overview == "" ? "No overview available." : root.overview;
        font-size: 13px;
        wrap: word-wrap;
        visible: false;
    }

    if !root.narrow: HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: 24px;
        width: min(parent.width - 56px, 1180px);
        height: parent.height - 40px;
        spacing: 28px;

        VerticalLayout {
            spacing: 10px;
            Text { text: "About"; color: Theme.text-primary; font-size: 21px; font-weight: 750; }
            wide-overview := Text {
                text: root.overview == "" ? "No overview available." : root.overview;
                color: Theme.text-secondary;
                font-size: 13px;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
        }

        Rectangle { width: 1px; background: Theme.surface-hover; }

        VerticalLayout {
            width: 300px;
            spacing: 8px;
            Text { text: "Details"; color: Theme.text-primary; font-size: 21px; font-weight: 750; }
            Text { text: "Genres"; color: Theme.text-faint; font-size: 11px; visible: root.genres != ""; }
            Text { text: root.genres; color: Theme.text-secondary; font-size: 12px; wrap: word-wrap; visible: root.genres != ""; }
            Text { text: "Studio"; color: Theme.text-faint; font-size: 11px; visible: root.studios != ""; }
            Text { text: root.studios; color: Theme.text-secondary; font-size: 12px; wrap: word-wrap; visible: root.studios != ""; }
            Text { text: "Media"; color: Theme.text-faint; font-size: 11px; visible: root.media-info != ""; }
            Text { text: root.media-info; color: Theme.text-secondary; font-size: 12px; wrap: word-wrap; visible: root.media-info != ""; }
            Text {
                text: "No additional details available.";
                color: Theme.text-faint;
                font-size: 12px;
                visible: root.genres == "" && root.studios == "" && root.media-info == "";
            }
            Rectangle { vertical-stretch: 1; }
        }
    }

    if root.narrow: VerticalLayout {
        x: 28px;
        y: 22px;
        width: parent.width - 56px;
        height: parent.height - 36px;
        spacing: 9px;

        Text { text: "About"; color: Theme.text-primary; font-size: 21px; font-weight: 750; }
        narrow-overview := Text {
            text: root.overview == "" ? "No overview available." : root.overview;
            color: Theme.text-secondary;
            font-size: 13px;
            wrap: word-wrap;
        }
        Rectangle { height: 1px; background: Theme.surface-hover; }
        Text { text: "Details"; color: Theme.text-primary; font-size: 18px; font-weight: 720; }
        Text { text: "Genres  " + root.genres; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; visible: root.genres != ""; }
        Text { text: "Studio  " + root.studios; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; visible: root.studios != ""; }
        Text { text: "Media  " + root.media-info; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; visible: root.media-info != ""; }
        Text {
            text: "No additional details available.";
            color: Theme.text-faint;
            font-size: 12px;
            visible: root.genres == "" && root.studios == "" && root.media-info == "";
        }
        Rectangle { vertical-stretch: 1; }
    }
}

component DetailSeasonCard inherits Rectangle {
    in property <DetailCard> season;
    callback open();

    height: root.width * 1.5 + 50px;
    background: transparent;

    card-focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.open();
                return accept;
            }
            return reject;
        }
    }
    card-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            card-focus.focus();
            root.open();
        }
    }

    VerticalLayout {
        spacing: 7px;
        Rectangle {
            height: root.width * 1.5;
            background: @linear-gradient(145deg, Theme.surface-hover 0%, Theme.bg 100%);
            border-color: card-focus.has-focus ? Theme.accent-bright : card-touch.has-hover ? Theme.border-strong : Theme.surface-hover;
            border-width: card-focus.has-focus ? 3px : card-touch.has-hover ? 2px : 1px;
            border-radius: Theme.radius-medium;
            clip: true;
            drop-shadow-color: card-touch.has-hover ? Theme.scrim.with-alpha(0.63) : Theme.scrim.with-alpha(0.4);
            drop-shadow-blur: card-touch.has-hover ? 14px : 7px;
            drop-shadow-offset-y: card-touch.has-hover ? 5px : 3px;

            Text {
                text: root.season.title;
                color: Theme.border-strong;
                font-size: 14px;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Image { source: root.season.artwork; width: 100%; height: 100%; image-fit: cover; }
            if root.season.unplayed-count > 0: Rectangle {
                x: parent.width - 42px;
                y: 9px;
                width: 32px;
                height: 25px;
                border-radius: Theme.radius-large;
                background: Theme.accent;
                Text {
                    text: root.season.unplayed-count;
                    color: white;
                    font-size: 11px;
                    font-weight: 750;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.season.watched && root.season.unplayed-count == 0: Rectangle {
                x: parent.width - 35px;
                y: 9px;
                width: 25px;
                height: 25px;
                border-radius: Theme.radius-large;
                background: Theme.accent;
                Text { text: "✓"; color: white; font-size: 14px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Text { text: root.season.title; color: Theme.text-primary; font-size: 14px; font-weight: 700; overflow: elide; }
        Text { text: root.season.subtitle; color: Theme.text-faint; font-size: 11px; overflow: elide; }
    }
}

component DetailSeasonShelf inherits Rectangle {
    in property <[DetailCard]> seasons;
    in property <string> summary;
    in property <bool> failed: false;
    callback open(string, string);
    property <length> card-width: 158px;
    property <length> content-width: max(0px, root.seasons.length * (root.card-width + 16px) - 16px);
    property <length> offset-x: 0px;
    property <length> viewport-width: min(root.width - 56px, 1180px);
    property <length> viewport-x: (root.width - root.viewport-width) / 2;
    property <length> minimum-offset: min(0px, root.viewport-width - root.content-width);
    background: Theme.bg;

    Text {
        x: root.viewport-x;
        y: 16px;
        text: "Seasons";
        color: Theme.text-primary;
        font-size: 22px;
        font-weight: 750;
    }
    Text {
        x: root.viewport-x;
        y: 20px;
        width: root.viewport-width;
        text: root.summary;
        color: Theme.text-faint;
        font-size: 12px;
        horizontal-alignment: right;
        visible: root.seasons.length > 0;
        overflow: elide;
    }

    if root.seasons.length == 0: Rectangle {
        x: root.viewport-x;
        y: 55px;
        width: root.viewport-width;
        height: 116px;
        background: Theme.surface;
        border-color: Theme.surface-hover;
        border-width: 1px;
        border-radius: Theme.radius-medium;
        Text {
            text: root.failed ? "Seasons could not be loaded." : "No seasons are available for this series.";
            color: Theme.text-muted;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    season-viewport := Rectangle {
        x: root.viewport-x;
        y: 55px;
        width: root.viewport-width;
        height: parent.height - 64px;
        clip: true;
        visible: root.seasons.length > 0;

        HorizontalLayout {
            x: root.offset-x;
            width: root.content-width;
            spacing: 16px;
            for season in root.seasons: DetailSeasonCard {
                width: root.card-width;
                season: season;
                open => { root.open(season.id, season.kind); }
            }
        }
    }

    Rectangle {
        x: root.viewport-x - 18px;
        y: 142px;
        width: 38px;
        height: 56px;
        border-radius: 19px;
        background: season-left-touch.has-hover ? Theme.overlay-raised : Theme.overlay;
        border-color: Theme.border;
        border-width: 1px;
        visible: root.offset-x < -1px;
        Text { text: "‹"; color: white; font-size: 27px; horizontal-alignment: center; vertical-alignment: center; }
        season-left-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.offset-x = min(0px, root.offset-x + season-viewport.width * 0.8); }
        }
    }

    Rectangle {
        x: root.viewport-x + root.viewport-width - 20px;
        y: 142px;
        width: 38px;
        height: 56px;
        border-radius: 19px;
        background: season-right-touch.has-hover ? Theme.overlay-raised : Theme.overlay;
        border-color: Theme.border;
        border-width: 1px;
        visible: root.content-width > root.viewport-width && root.offset-x > root.minimum-offset + 1px;
        Text { text: "›"; color: white; font-size: 27px; horizontal-alignment: center; vertical-alignment: center; }
        season-right-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.offset-x = max(root.minimum-offset, root.offset-x - season-viewport.width * 0.8); }
        }
    }
}

component DetailEpisodeRow inherits Rectangle {
    in property <DetailCard> episode;
    in property <bool> busy: false;
    property <bool> emphasized: row-touch.has-hover || row-focus.has-focus;
    callback open(string, string);
    callback play(string);
    callback set-watched(string, bool);
    height: 142px;
    background: root.episode.watched
        ? (root.emphasized ? Theme.surface : Theme.bg)
        : (row-touch.has-hover ? Theme.surface-raised : Theme.surface);
    border-color: row-focus.has-focus
        ? Theme.accent-bright
        : root.episode.watched
            ? (row-touch.has-hover ? Theme.border : Theme.surface-raised)
            : (row-touch.has-hover ? Theme.border : Theme.surface-hover);
    border-width: row-focus.has-focus ? 2px : 1px;
    border-radius: Theme.radius-medium;
    clip: true;

    row-focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.open(root.episode.id, root.episode.kind);
                return accept;
            }
            return reject;
        }
    }
    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            row-focus.focus();
            root.open(root.episode.id, root.episode.kind);
        }
    }
    HorizontalLayout {
        padding: 12px;
        spacing: 16px;
        Rectangle {
            width: 208px;
            height: 117px;
            background: @linear-gradient(145deg, Theme.surface-raised 0%, Theme.bg 100%);
            border-radius: Theme.radius-small;
            clip: true;
            Text {
                text: root.episode.subtitle == "" ? "Episode" : root.episode.subtitle;
                color: Theme.border-strong;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            Image { source: root.episode.artwork; width: 100%; height: 100%; image-fit: cover; }
            if root.episode.watched: Rectangle {
                background: root.emphasized ? Theme.bg.with-alpha(0.45) : Theme.bg.with-alpha(0.63);
            }
            if root.episode.watched: Rectangle { x: parent.width - 31px; y: 7px; width: 24px; height: 24px; border-radius: Theme.radius-large; background: Theme.accent; Text { text: "✓"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
            if root.episode.progress > 0 && root.episode.progress < 1: Rectangle { y: parent.height - 5px; width: parent.width; height: 5px; background: Theme.surface-raised; Rectangle { x: 0px; width: parent.width * root.episode.progress; height: 100%; background: Theme.accent; } }
        }
        VerticalLayout {
            spacing: 7px;
            Text {
                text: root.episode.title;
                color: root.episode.watched ? (root.emphasized ? Theme.text-secondary : Theme.text-faint) : Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.episode.subtitle;
                color: root.episode.watched ? (root.emphasized ? Theme.text-faint : Theme.border-strong) : Theme.accent-bright;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.episode.overview == "" ? "No episode overview available." : root.episode.overview;
                color: root.episode.watched ? (root.emphasized ? Theme.text-faint : Theme.text-faint) : Theme.text-muted;
                font-size: 12px;
                wrap: word-wrap;
                max-height: 48px;
                overflow: elide;
            }
            Rectangle { vertical-stretch: 1; }
        }
        VerticalLayout {
            width: 118px;
            spacing: 8px;
            Rectangle { vertical-stretch: 1; }
            DetailActionButton {
                width: 118px;
                text: root.episode.progress > 0 && !root.episode.watched ? "Resume" : "Play";
                primary: true;
                enabled: !root.busy;
                clicked => { root.play(root.episode.id); }
            }
            DetailActionButton {
                width: 118px;
                text: root.episode.watched ? "✓ Watched" : "Mark watched";
                active: root.episode.watched;
                enabled: !root.busy;
                clicked => { root.set-watched(root.episode.id, !root.episode.watched); }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

component DetailPeopleShelf inherits Rectangle {
    in property <[DetailPerson]> people;
    property <length> card-width: 112px;
    property <length> content-width: max(0px, root.people.length * (root.card-width + 16px) - 16px);
    property <length> offset-x: 0px;
    property <length> viewport-width: min(root.width - 56px, 1180px);
    property <length> viewport-x: (root.width - root.viewport-width) / 2;
    property <length> minimum-offset: min(0px, root.viewport-width - root.content-width);
    background: Theme.bg;

    Text {
        x: root.viewport-x;
        y: 12px;
        text: "Cast";
        color: Theme.text-primary;
        font-size: 21px;
        font-weight: 750;
    }
    cast-viewport := Rectangle {
        x: root.viewport-x;
        y: 49px;
        width: root.viewport-width;
        height: parent.height - 57px;
        clip: true;
        HorizontalLayout {
            x: root.offset-x;
            width: root.content-width;
            spacing: 14px;
            for person in root.people: Rectangle {
                width: root.card-width;
                background: transparent;
                VerticalLayout {
                    spacing: 6px;
                    Rectangle {
                        height: root.card-width;
                        border-radius: root.card-width / 2;
                        background: @linear-gradient(145deg, Theme.surface-hover 0%, Theme.surface 100%);
                        border-color: Theme.border;
                        border-width: 1px;
                        clip: true;
                        Text {
                            text: "?";
                            color: Theme.border-strong;
                            font-size: 28px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Image { source: person.artwork; width: 100%; height: 100%; image-fit: cover; }
                    }
                    Text { text: person.name; color: Theme.text-primary; font-size: 12px; font-weight: 650; horizontal-alignment: center; overflow: elide; }
                    Text { text: person.role; color: Theme.text-faint; font-size: 10px; horizontal-alignment: center; overflow: elide; }
                }
            }
        }
    }

    Rectangle {
        x: root.viewport-x - 18px;
        y: 80px;
        width: 38px;
        height: 56px;
        border-radius: 19px;
        background: cast-left-touch.has-hover ? Theme.overlay-raised : Theme.overlay;
        border-color: Theme.border;
        border-width: 1px;
        visible: root.offset-x < -1px;
        Text { text: "‹"; color: white; font-size: 27px; horizontal-alignment: center; vertical-alignment: center; }
        cast-left-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.offset-x = min(0px, root.offset-x + cast-viewport.width * 0.8); }
        }
    }

    Rectangle {
        x: root.viewport-x + root.viewport-width - 20px;
        y: 80px;
        width: 38px;
        height: 56px;
        border-radius: 19px;
        background: cast-right-touch.has-hover ? Theme.overlay-raised : Theme.overlay;
        border-color: Theme.border;
        border-width: 1px;
        visible: root.content-width > root.viewport-width && root.offset-x > root.minimum-offset + 1px;
        Text { text: "›"; color: white; font-size: 27px; horizontal-alignment: center; vertical-alignment: center; }
        cast-right-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.offset-x = max(root.minimum-offset, root.offset-x - cast-viewport.width * 0.8); }
        }
    }
}

component MediaTile inherits Rectangle {
    in property <CatalogItem> item;
    in property <bool> manage-scroll: false;
    callback opened();
    callback scroll-requested(length, length);

    height: self.width * 1.5 + 58px;
    background: transparent;

    tile-focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.opened();
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        spacing: 8px;

        poster := Rectangle {
            height: root.width * 1.5;
            background: Theme.surface;
            border-color: tile-focus.has-focus ? Theme.accent-bright : tile-touch.has-hover ? Theme.text-faint : Theme.surface-hover;
            border-width: tile-focus.has-focus ? 3px : tile-touch.has-hover ? 2px : 1px;
            border-radius: Theme.radius-medium;
            clip: true;
            drop-shadow-color: tile-touch.has-hover ? Theme.scrim.with-alpha(0.66) : Theme.scrim.with-alpha(0.44);
            drop-shadow-blur: tile-touch.has-hover ? 15px : 8px;
            drop-shadow-offset-y: tile-touch.has-hover ? 5px : 3px;

            Rectangle {
                background: @linear-gradient(145deg, Theme.accent-surface 0%, Theme.bg 100%);
                Text {
                    text: root.item.placeholder;
                    color: Theme.border-strong;
                    font-size: min(parent.width / 3, 42px);
                    font-weight: 750;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Image {
                source: root.item.artwork;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }

            Rectangle {
                x: 8px;
                y: 8px;
                width: kind-label.preferred-width + 14px;
                height: 24px;
                border-radius: Theme.radius-large;
                background: Theme.bg.with-alpha(0.86);
                kind-label := Text {
                    text: root.item.kind-label;
                    color: Theme.text-primary;
                    font-size: 10px;
                    font-weight: 650;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.item.watched: Rectangle {
                x: parent.width - 34px;
                y: 8px;
                width: 26px;
                height: 26px;
                border-radius: Theme.radius-large;
                background: Theme.accent;
                Text {
                    text: "✓";
                    color: Theme.text-bright;
                    font-size: 15px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.item.progress > 0 && root.item.progress < 1: Rectangle {
                x: 0px;
                y: parent.height - 6px;
                width: parent.width;
                height: 6px;
                background: Theme.overlay;
                Rectangle {
                    x: 0px;
                    width: parent.width * root.item.progress;
                    height: parent.height;
                    background: Theme.accent;
                }
            }

            tile-touch := TouchArea {
                mouse-cursor: pointer;
                scroll-event(event) => {
                    if root.manage-scroll && (event.delta-x != 0px || event.delta-y != 0px) {
                        root.scroll-requested(event.delta-x, event.delta-y);
                        return accept;
                    }
                    return reject;
                }
                clicked => {
                    tile-focus.focus();
                    root.opened();
                }
            }
        }

        Text {
            text: root.item.title;
            color: Theme.text-primary;
            font-size: 14px;
            font-weight: 650;
            overflow: elide;
        }
        Text {
            text: root.item.subtitle == "" ? root.item.kind : root.item.subtitle;
            color: Theme.text-faint;
            font-size: 12px;
            overflow: elide;
        }
    }
}

component CatalogShelf inherits Rectangle {
    in property <CatalogSection> section;
    in property <[CatalogItem]> items;
    in property <length> card-width: 176px;
    callback open-item(string, string, bool, bool);
    callback vertical-scroll(length);
    property <length> content-width: root.section.count * (root.card-width + 16px) - 16px;
    property <length> shelf-offset-x: 0px;
    property <length> minimum-shelf-offset: min(0px, shelf.width - root.content-width);

    height: card-width * 1.5 + 112px;
    background: transparent;

    Text {
        x: 24px;
        y: 7px;
        text: root.section.title;
        color: Theme.text-primary;
        font-size: 20px;
        font-weight: 720;
    }

    shelf := Rectangle {
        x: 24px;
        y: 43px;
        width: parent.width - 48px;
        height: root.card-width * 1.5 + 62px;
        background: transparent;
        clip: true;

        HorizontalLayout {
            x: root.shelf-offset-x;
            width: root.content-width;
            spacing: 16px;
            for shelf-entry[item-index] in root.section.count: MediaTile {
                width: root.card-width;
                item: root.items[root.section.start-index + item-index];
                manage-scroll: true;
                opened => {
                    root.open-item(self.item.id, self.item.kind, self.item.is-container, self.item.playable);
                }
                scroll-requested(delta-x, delta-y) => {
                    if abs(delta-x) > abs(delta-y) {
                        root.shelf-offset-x = max(
                            root.minimum-shelf-offset,
                            min(0px, root.shelf-offset-x + delta-x)
                        );
                    } else {
                        root.vertical-scroll(delta-y);
                    }
                }
            }
        }
    }

    Rectangle {
        x: 4px;
        y: 43px + root.card-width * 0.62;
        width: 38px;
        height: 58px;
        border-radius: 19px;
        background: left-touch.has-hover ? Theme.overlay-raised : Theme.overlay-dim;
        visible: root.shelf-offset-x < -1px;
        Text { text: "‹"; color: Theme.text-bright; font-size: 28px; horizontal-alignment: center; vertical-alignment: center; }
        left-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.shelf-offset-x = min(0px, root.shelf-offset-x + shelf.width * 0.8); }
        }
    }

    Rectangle {
        x: parent.width - 42px;
        y: 43px + root.card-width * 0.62;
        width: 38px;
        height: 58px;
        border-radius: 19px;
        background: right-touch.has-hover ? Theme.overlay-raised : Theme.overlay-dim;
        visible: root.content-width > shelf.width && root.shelf-offset-x > root.minimum-shelf-offset + 1px;
        Text { text: "›"; color: Theme.text-bright; font-size: 28px; horizontal-alignment: center; vertical-alignment: center; }
        right-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.shelf-offset-x = max(root.minimum-shelf-offset, root.shelf-offset-x - shelf.width * 0.8); }
        }
    }
}

export component JellyBridgeWindow inherits Window {
    title: "JellyBridge";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.bg;

    // `in`: Rust owns it. `in-out`: genuinely edited from both sides.
    // `private`: nobody outside this component should know it exists.
    in property <Screen> screen: Screen.login;
    in property <bool> busy: false;
    in property <string> message: "";
    in property <string> page-title: "Home";
    in property <string> account-name: "";
    in property <string> account-initial: "?";
    in property <bool> can-go-back: false;
    in property <[CatalogSection]> sections;
    in property <[CatalogItem]> catalog-items;
    in property <string> catalog-summary: "";
    in property <bool> catalog-home: false;
    in-out property <string> search-text: "";
    in property <[string]> sort-options;
    in-out property <int> sort-index: 0;
    in-out property <int> density-index: 1;
    in property <float> tile-target-width: 260;
    property <int> grid-columns: max(1, floor((root.width / 1px - 48 + 18) / (root.tile-target-width + 18)));
    property <length> grid-card-width: (root.width - 48px - (root.grid-columns - 1) * 18px) / root.grid-columns;
    property <int> grid-row-count: ceil(root.catalog-items.length / root.grid-columns);
    property <length> home-scroll-target-y: 0px;
    property <length> home-scroll-y: root.home-scroll-target-y;
    animate home-scroll-y { duration: 220ms; easing: ease-out; }

    in property <string> detail-id: "";
    in property <string> detail-title: "";
    in property <string> detail-subtitle: "";
    in property <string> detail-overview: "";
    in property <image> detail-artwork;
    in property <image> detail-backdrop;
    in property <image> detail-logo;
    in property <DetailKind> detail-kind: DetailKind.other;
    in property <string> detail-tagline: "";
    in property <string> detail-genres: "";
    in property <string> detail-studios: "";
    in property <string> detail-media-info: "";
    in property <string> detail-series-id: "";
    in property <string> detail-series-name: "";
    in property <string> detail-series-summary: "";
    in property <string> detail-play-context: "";
    in property <string> detail-season-id: "";
    in property <string> detail-season-name: "";
    in property <string> detail-season-summary: "";
    in property <string> detail-play-label: "";
    in property <float> detail-progress: 0;
    in property <string> detail-progress-label: "";
    in property <bool> detail-playable: false;
    in property <bool> detail-watched: false;
    in property <bool> detail-favorite: false;
    in property <bool> detail-wide-art: false;
    in property <[DetailCard]> detail-seasons;
    in property <[DetailCard]> detail-episodes;
    in property <[DetailPerson]> detail-people;
    in property <[string]> detail-audio-options;
    in property <[string]> detail-subtitle-options;
    in-out property <int> detail-audio-index: 0;
    in-out property <int> detail-subtitle-index: 0;

    in property <image> video-frame;
    in property <string> player-status: "Preparing playback…";
    in property <bool> paused: false;
    in-out property <float> volume: 100;
    in property <bool> fullscreen-player: false;
    in property <bool> controls-visible: true;
    in-out property <float> playback-position: 0;
    in-out property <float> playback-duration: 0;
    private property <float> timeline-position: 0;
    private property <bool> timeline-scrubbing: false;
    out property <float> timeline-display-position: root.timeline-position;
    in property <string> playback-position-label: "0:00";
    in property <string> playback-duration-label: "0:00";
    in property <[string]> audio-options;
    in property <[string]> subtitle-options;
    in-out property <int> audio-index: 0;
    in-out property <int> subtitle-index: 0;
    out property <float> video-logical-width: root.width / 1px;
    out property <float> video-logical-height: max(root.height - 112px, 1px) / 1px;

    callback login(string, string, string);
    callback logout();
    callback retry();
    callback open-item(string, string, bool, bool);
    callback search(string);
    callback sort-changed(int);
    callback density-changed(int);
    callback go-home();
    callback go-back();
    callback play-current();
    callback open-detail(string, string);
    callback play-detail(string);
    callback set-detail-watched(string, bool);
    callback set-detail-favorite(string, bool);
    callback detail-audio-selected(int);
    callback detail-subtitle-selected(int);
    callback toggle-playback();
    callback toggle-mute();
    callback seek-relative(float);
    callback volume-changed(float);
    callback seek-absolute(float);
    callback select-audio(int);
    callback select-subtitle(int);
    callback toggle-fullscreen();
    callback player-activity();
    callback leave-player();
    callback player-key-pressed(string, bool, bool, bool) -> bool;

    // Initializes the timeline and grabs hotkey focus. Rust sets `screen` to
    // Screen.player itself before invoking this — a component cannot assign
    // its own `in` property.
    public function enter-player(initial-position: float, initial-duration: float) {
        root.playback-duration = max(initial-duration, 0);
        root.playback-position = clamp(initial-position, 0, max(root.playback-duration, 1));
        root.timeline-position = root.playback-position;
        root.timeline-scrubbing = false;
        app-key-scope.focus();
    }

    changed playback-position => {
        if !root.timeline-scrubbing {
            root.timeline-position = clamp(root.playback-position, 0, max(root.playback-duration, 1));
        }
    }

    changed playback-duration => {
        if !root.timeline-scrubbing {
            root.timeline-position = clamp(root.playback-position, 0, max(root.playback-duration, 1));
        }
    }

    forward-focus: app-key-scope;

    app-key-scope := FocusScope {
        capture-key-pressed(event) => {
            if root.screen == Screen.player && root.player-key-pressed(
                event.text,
                event.repeat,
                event.modifiers.shift,
                event.modifiers.control || event.modifiers.meta || event.modifiers.alt
            ) {
                return accept;
            }
            return reject;
        }

    if root.screen == Screen.login: Rectangle {
        background: @linear-gradient(180deg, Theme.bg 0%, Theme.surface-dim 100%);

        Rectangle {
            width: min(parent.width - 48px, 860px);
            height: 430px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Theme.radius-large;
            drop-shadow-color: Theme.scrim.with-alpha(0.5);
            drop-shadow-blur: 24px;

            HorizontalLayout {
                padding: 38px;
                spacing: 40px;

                VerticalLayout {
                    width: 42%;
                    alignment: center;
                    spacing: 12px;

                    Rectangle {
                        width: 62px;
                        height: 62px;
                        border-radius: Theme.radius-large;
                        background: Theme.accent-surface;
                        Image {
                            source: @image-url("../assets/icon.png");
                            width: 100%;
                            height: 100%;
                            image-fit: contain;
                        }
                    }
                    Text {
                        text: "JellyBridge";
                        color: Theme.accent;
                        font-size: 36px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Native Jellyfin playback with MPV";
                        color: Theme.text-muted;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Theme.border;
                }

                VerticalLayout {
                    spacing: 13px;
                    vertical-stretch: 1;

                    Text {
                        text: "Sign in";
                        color: Theme.text-primary;
                        font-size: 25px;
                        font-weight: 700;
                    }
                    Text { text: "Server URL"; color: Theme.text-muted; font-size: 12px; }
                    server-input := LineEdit {
                        text: "http://";
                        enabled: !root.busy;
                        placeholder-text: "http://jellyfin.local:8096";
                    }
                    Text { text: "Username"; color: Theme.text-muted; font-size: 12px; }
                    username-input := LineEdit {
                        enabled: !root.busy;
                        placeholder-text: "Jellyfin username";
                    }
                    Text { text: "Password"; color: Theme.text-muted; font-size: 12px; }
                    password-input := LineEdit {
                        enabled: !root.busy;
                        input-type: password;
                        placeholder-text: "Password";
                        accepted => {
                            root.login(server-input.text, username-input.text, self.text);
                        }
                    }
                    Text {
                        text: root.message;
                        color: Theme.danger-text;
                        font-size: 12px;
                        wrap: word-wrap;
                        visible: root.message != "";
                    }
                    Button {
                        text: root.busy ? "Connecting…" : "Connect";
                        enabled: !root.busy && server-input.text != "" && username-input.text != "";
                        clicked => {
                            root.login(server-input.text, username-input.text, password-input.text);
                        }
                    }
                }
            }
        }
    }

    if root.screen == Screen.catalog || root.screen == Screen.detail: VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 64px;
            background: Theme.bg.with-alpha(0.96);

            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.surface-hover;
            }

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 10px;
                padding-bottom: 11px;
                spacing: 10px;

                Rectangle {
                    width: 42px;
                    border-radius: 21px;
                    background: back-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    visible: root.can-go-back || root.screen == Screen.detail;
                    Text {
                        text: "‹";
                        color: Theme.text-primary;
                        font-size: 27px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    back-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.go-back(); }
                    }
                }

                brand := Rectangle {
                    width: 172px;
                    background: transparent;
                    Rectangle {
                        x: 0px;
                        y: 2px;
                        width: 38px;
                        height: 38px;
                        border-radius: Theme.radius-large;
                        background: @linear-gradient(145deg, Theme.accent 0%, Theme.accent-deep 100%);
                        Image {
                            source: @image-url("../assets/icon.png");
                            width: 100%;
                            height: 100%;
                            image-fit: contain;
                        }
                    }
                    Text {
                        x: 49px;
                        text: "JellyBridge";
                        color: Theme.text-primary;
                        font-size: 19px;
                        font-weight: 760;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.go-home(); }
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Theme.border;
                }

                Rectangle {
                    width: 70px;
                    border-radius: Theme.radius-medium;
                    background: root.catalog-home && root.screen == Screen.catalog
                        ? Theme.accent-surface
                        : home-touch.has-hover ? Theme.surface-raised : transparent;
                    Text {
                        text: "Home";
                        color: root.catalog-home && root.screen == Screen.catalog ? Theme.accent-bright : Theme.text-secondary;
                        font-size: 13px;
                        font-weight: 650;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    home-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.go-home(); }
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.screen == Screen.detail ? root.detail-title : root.page-title;
                    color: Theme.text-faint;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle {
                    width: 174px;
                    border-radius: 21px;
                    background: Theme.surface;
                    border-color: Theme.surface-hover;
                    border-width: 1px;

                    Rectangle {
                        x: 5px;
                        y: 4px;
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: Theme.accent-deep;
                        Text {
                            text: root.account-initial;
                            color: white;
                            font-size: 15px;
                            font-weight: 750;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        x: 48px;
                        width: parent.width - 58px;
                        text: root.account-name;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle {
                    width: 82px;
                    border-radius: Theme.radius-medium;
                    background: logout-touch.has-hover ? Theme.danger-surface : transparent;
                    border-color: logout-touch.has-hover ? Theme.danger-border : Theme.border;
                    border-width: 1px;
                    Text {
                        text: "Sign out";
                        color: logout-touch.has-hover ? Theme.danger-text : Theme.text-muted;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    logout-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.logout(); }
                    }
                }
            }
        }

        if root.screen == Screen.catalog: VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: root.width < 980px ? 142px : 92px;
                background: Theme.bg;

                Text {
                    x: 24px;
                    y: 14px;
                    text: root.page-title;
                    color: Theme.text-primary;
                    font-size: 27px;
                    font-weight: 750;
                    overflow: elide;
                }
                Text {
                    x: 24px;
                    y: 52px;
                    text: root.catalog-summary;
                    color: Theme.text-faint;
                    font-size: 12px;
                }

                search-debounce := Timer {
                    interval: 300ms;
                    triggered => { root.search(root.search-text); }
                }

                search-input := LineEdit {
                    x: root.width < 980px ? 24px : parent.width - 696px;
                    y: root.width < 980px ? 91px : 26px;
                    width: root.width < 980px ? parent.width - 482px : 300px;
                    text <=> root.search-text;
                    placeholder-text: root.catalog-home ? "Search all media" : "Search this library";
                    enabled: !root.busy;
                    edited => { search-debounce.restart(); }
                    accepted => {
                        search-debounce.stop();
                        root.search(self.text);
                    }
                }

                sort-combo := ComboBox {
                    x: root.width < 980px ? parent.width - 440px : parent.width - 380px;
                    y: root.width < 980px ? 91px : 26px;
                    width: 222px;
                    model: root.sort-options;
                    current-index: root.sort-index;
                    enabled: !root.busy;
                    selected(_) => {
                        root.sort-index = self.current-index;
                        root.sort-changed(self.current-index);
                    }
                }

                density-controls := Rectangle {
                    x: parent.width - 204px;
                    y: root.width < 980px ? 91px : 26px;
                    width: 180px;
                    height: 32px;
                    border-radius: Theme.radius-small;
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;

                    HorizontalLayout {
                        spacing: 2px;
                        padding: 3px;
                        for density-label[density-item-index] in ["Compact", "Normal", "Large"]: Rectangle {
                            border-radius: Theme.radius-small;
                            background: root.density-index == density-item-index ? Theme.accent-deep : density-touch.has-hover ? Theme.surface-hover : transparent;
                            Text {
                                text: density-label;
                                color: root.density-index == density-item-index ? Theme.text-bright : Theme.text-muted;
                                font-size: 10px;
                                font-weight: root.density-index == density-item-index ? 700 : 500;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            density-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.density-index = density-item-index;
                                    root.density-changed(density-item-index);
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.surface-raised;
            }

            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg;

                if root.busy: VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    Text {
                        text: "Loading your library…";
                        color: Theme.text-muted;
                        font-size: 16px;
                        horizontal-alignment: center;
                    }
                }

                if !root.busy && root.catalog-items.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    Text {
                        text: root.message == "" ? (root.search-text == "" ? "Nothing to show" : "No matching media") : root.message;
                        color: root.message == "" ? Theme.text-muted : Theme.danger-text;
                        font-size: 16px;
                        horizontal-alignment: center;
                    }
                    Button {
                        text: "Retry";
                        visible: root.message != "";
                        clicked => { root.retry(); }
                    }
                }

                if !root.busy && root.catalog-items.length > 0 && root.catalog-home: home-list := ListView {
                    width: parent.width;
                    height: parent.height;
                    viewport-y: root.home-scroll-y;
                    for section in root.sections: CatalogShelf {
                        width: root.width;
                        section: section;
                        items: root.catalog-items;
                        card-width: root.tile-target-width * 1px;
                        open-item(id, kind, is-container, playable) => {
                            root.open-item(id, kind, is-container, playable);
                        }
                        vertical-scroll(delta-y) => {
                            root.home-scroll-target-y = max(
                                home-list.height - home-list.viewport-height,
                                min(
                                    0px,
                                    root.home-scroll-target-y + max(-480px, min(480px, delta-y))
                                )
                            );
                        }
                    }
                }

                if !root.busy && root.catalog-items.length > 0 && !root.catalog-home: ListView {
                    width: parent.width;
                    height: parent.height;
                    for grid-row[row-index] in root.grid-row-count: Rectangle {
                        width: root.width;
                        height: root.grid-card-width * 1.5 + 82px;
                        background: transparent;
                        HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            spacing: 18px;
                            for grid-column[column-index] in root.grid-columns: Rectangle {
                                width: root.grid-card-width;
                                background: transparent;
                                property <int> catalog-index: row-index * root.grid-columns + column-index;
                                if self.catalog-index < root.catalog-items.length: MediaTile {
                                    width: parent.width;
                                    item: root.catalog-items[parent.catalog-index];
                                    opened => {
                                        root.open-item(self.item.id, self.item.kind, self.item.is-container, self.item.playable);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: root.message != "" && root.catalog-items.length > 0 ? 38px : 0px;
                background: Theme.danger-surface;
                Text {
                    text: root.message;
                    color: Theme.danger-text;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if root.screen == Screen.detail: Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;

            ScrollView {
              VerticalLayout {
                spacing: 0px;
                if root.detail-kind != DetailKind.series && root.detail-kind != DetailKind.season && root.detail-kind != DetailKind.movie && root.detail-kind != DetailKind.episode: DetailHero {
                    width: root.width;
                    height: 400px;
                    title: root.detail-title;
                    tagline: root.detail-tagline;
                    metadata: root.detail-subtitle;
                    overview: root.detail-overview;
                    genres: root.detail-genres;
                    studios: root.detail-studios;
                    media-info: root.detail-media-info;
                    series-id: root.detail-series-id;
                    series-name: root.detail-series-name;
                    season-id: root.detail-season-id;
                    season-name: root.detail-season-name;
                    poster: root.detail-artwork;
                    backdrop: root.detail-backdrop;
                    logo: root.detail-logo;
                    wide-art: root.detail-wide-art;
                    playable: root.detail-playable;
                    watched: root.detail-watched;
                    favorite: root.detail-favorite;
                    busy: root.busy;
                    audio-options: root.detail-audio-options;
                    subtitle-options: root.detail-subtitle-options;
                    audio-index <=> root.detail-audio-index;
                    subtitle-index <=> root.detail-subtitle-index;
                    play => { root.play-current(); }
                    set-watched(value) => { root.set-detail-watched(root.detail-id, value); }
                    set-favorite(value) => { root.set-detail-favorite(root.detail-id, value); }
                    audio-selected(index) => { root.detail-audio-selected(index); }
                    subtitle-selected(index) => { root.detail-subtitle-selected(index); }
                    open-related(id, kind) => { root.open-detail(id, kind); }
                }

                if root.detail-kind == DetailKind.series: SeriesDetailHeader {
                    width: root.width;
                    title: root.detail-title;
                    tagline: root.detail-tagline;
                    metadata: root.detail-subtitle;
                    summary: root.detail-series-summary;
                    play-context: root.detail-play-context;
                    progress: root.detail-progress;
                    poster: root.detail-artwork;
                    backdrop: root.detail-backdrop;
                    play-label: root.detail-play-label;
                    playable: root.detail-playable;
                    watched: root.detail-watched;
                    favorite: root.detail-favorite;
                    busy: root.busy;
                    play => { root.play-current(); }
                    set-watched(value) => { root.set-detail-watched(root.detail-id, value); }
                    set-favorite(value) => { root.set-detail-favorite(root.detail-id, value); }
                }

                if root.detail-kind == DetailKind.movie || root.detail-kind == DetailKind.episode: MediaDetailHeader {
                    width: root.width;
                    title: root.detail-title;
                    tagline: root.detail-tagline;
                    metadata: root.detail-subtitle;
                    series-id: root.detail-series-id;
                    series-name: root.detail-series-name;
                    season-id: root.detail-season-id;
                    season-name: root.detail-season-name;
                    artwork: root.detail-artwork;
                    backdrop: root.detail-backdrop;
                    episode: root.detail-kind == DetailKind.episode;
                    play-label: root.detail-play-label;
                    progress: root.detail-progress;
                    progress-label: root.detail-progress-label;
                    playable: root.detail-playable;
                    watched: root.detail-watched;
                    favorite: root.detail-favorite;
                    busy: root.busy;
                    audio-options: root.detail-audio-options;
                    subtitle-options: root.detail-subtitle-options;
                    audio-index <=> root.detail-audio-index;
                    subtitle-index <=> root.detail-subtitle-index;
                    play => { root.play-current(); }
                    set-watched(value) => { root.set-detail-watched(root.detail-id, value); }
                    set-favorite(value) => { root.set-detail-favorite(root.detail-id, value); }
                    audio-selected(index) => { root.detail-audio-selected(index); }
                    subtitle-selected(index) => { root.detail-subtitle-selected(index); }
                    open-related(id, kind) => { root.open-detail(id, kind); }
                }

                if root.detail-kind == DetailKind.season: SeasonDetailHeader {
                    width: root.width;
                    title: root.detail-title;
                    metadata: root.detail-subtitle;
                    summary: root.detail-season-summary;
                    overview: root.detail-overview;
                    series-id: root.detail-series-id;
                    series-name: root.detail-series-name;
                    poster: root.detail-artwork;
                    backdrop: root.detail-backdrop;
                    play-label: root.detail-play-label;
                    playable: root.detail-playable;
                    watched: root.detail-watched;
                    favorite: root.detail-favorite;
                    busy: root.busy;
                    play => { root.play-current(); }
                    set-watched(value) => { root.set-detail-watched(root.detail-id, value); }
                    set-favorite(value) => { root.set-detail-favorite(root.detail-id, value); }
                    open-series(id) => { root.open-detail(id, "Series"); }
                }

                if root.message != "": Rectangle {
                    width: root.width;
                    height: 38px; background: Theme.danger-surface;
                    Text { text: root.message; color: Theme.danger-text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    Button { x: parent.width - 92px; y: 4px; width: 80px; height: 30px; text: "Retry"; clicked => { root.retry(); } }
                }

                if root.detail-kind == DetailKind.movie || root.detail-kind == DetailKind.episode: MediaInformationSection {
                    width: root.width;
                    overview: root.detail-overview;
                    genres: root.detail-genres;
                    studios: root.detail-studios;
                    media-info: root.detail-media-info;
                }

                if root.detail-kind == DetailKind.series: DetailSeasonShelf {
                    width: root.width;
                    height: 360px;
                    seasons: root.detail-seasons;
                    summary: root.detail-series-summary;
                    failed: root.message != "";
                    open(id, kind) => { root.open-detail(id, kind); }
                }

                if root.detail-kind == DetailKind.series: MediaInformationSection {
                    width: root.width;
                    overview: root.detail-overview;
                    genres: root.detail-genres;
                    studios: root.detail-studios;
                    media-info: root.detail-media-info;
                }

                if root.detail-kind == DetailKind.season: VerticalLayout {
                    width: root.width;
                    padding-top: 20px;
                    padding-bottom: 28px;
                    spacing: 10px;

                    HorizontalLayout {
                        height: 38px;
                        padding-left: max(28px, (root.width - 1180px) / 2);
                        padding-right: max(28px, (root.width - 1180px) / 2);
                        Text {
                            text: "Episodes";
                            color: Theme.text-primary;
                            font-size: 22px;
                            font-weight: 750;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.detail-season-summary;
                            color: Theme.text-faint;
                            font-size: 12px;
                            vertical-alignment: center;
                            visible: root.detail-episodes.length > 0;
                        }
                    }

                    if root.detail-episodes.length == 0: HorizontalLayout {
                        height: 116px;
                        padding-left: max(28px, (root.width - 1180px) / 2);
                        padding-right: max(28px, (root.width - 1180px) / 2);
                        Rectangle {
                            background: Theme.surface;
                            border-color: Theme.surface-hover;
                            border-width: 1px;
                            border-radius: Theme.radius-medium;
                            Text {
                                text: root.message == "" ? "No episodes are available for this season." : "Episodes could not be loaded.";
                                color: Theme.text-muted;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    for episode in root.detail-episodes: HorizontalLayout {
                        height: 142px;
                        padding-left: max(28px, (root.width - 1180px) / 2);
                        padding-right: max(28px, (root.width - 1180px) / 2);
                        DetailEpisodeRow {
                            horizontal-stretch: 1;
                            episode: episode;
                            busy: root.busy;
                            open(id, kind) => { root.open-detail(id, kind); }
                            play(id) => { root.play-detail(id); }
                            set-watched(id, watched) => { root.set-detail-watched(id, watched); }
                        }
                    }
                }

                if root.detail-people.length > 0: DetailPeopleShelf {
                    width: root.width;
                    height: 220px;
                    people: root.detail-people;
                }
              }
            }
        }
    }

    if root.screen == Screen.player: Rectangle {
        background: Theme.scrim;
        player-surface := Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.video-bg;
            clip: true;

            Image {
                source: root.video-frame;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            single-click-timer := Timer {
                running: false;
                interval: 220ms;
                triggered => {
                    single-click-timer.stop();
                    root.toggle-playback();
                }
            }

            player-pointer := TouchArea {
                mouse-cursor: root.fullscreen-player && !root.controls-visible ? none : default;
                moved => { root.player-activity(); }
                clicked => {
                    root.player-activity();
                    single-click-timer.start();
                }
                double-clicked => {
                    single-click-timer.stop();
                    root.player-activity();
                    root.toggle-fullscreen();
                }
            }
        }

        Rectangle {
            visible: !root.fullscreen-player || root.controls-visible;
            x: root.fullscreen-player ? 24px : 0px;
            y: root.fullscreen-player ? 24px : 0px;
            width: root.fullscreen-player ? parent.width - 48px : parent.width;
            height: 64px;
            border-radius: root.fullscreen-player ? 10px : 0px;
            background: Theme.bg.with-alpha(0.91);

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Button {
                    text: "‹ Back";
                    clicked => { root.player-activity(); root.leave-player(); }
                }
                Text {
                    text: root.detail-title;
                    color: Theme.text-primary;
                    font-size: 19px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.player-status;
                    color: Theme.text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            visible: !root.fullscreen-player || root.controls-visible;
            x: root.fullscreen-player ? 24px : 0px;
            y: parent.height - self.height - (root.fullscreen-player ? 24px : 0px);
            width: root.fullscreen-player ? parent.width - 48px : parent.width;
            height: 158px;
            border-radius: root.fullscreen-player ? 10px : 0px;
            background: Theme.bg.with-alpha(0.93);

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.playback-position-label;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    player-timeline := Slider {
                        minimum: 0;
                        maximum: max(root.playback-duration, 1);
                        value <=> root.timeline-position;
                        horizontal-stretch: 1;
                        changed(value) => {
                            root.timeline-scrubbing = true;
                        }
                        released(value) => {
                            root.player-activity();
                            root.playback-position = value;
                            root.timeline-scrubbing = false;
                            root.seek-absolute(value);
                        }
                    }
                    Text {
                        text: root.playback-duration-label;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: root.paused ? "Play" : "Pause";
                        clicked => { root.player-activity(); root.toggle-playback(); }
                    }
                    Button {
                        text: "−10 s";
                        clicked => { root.player-activity(); root.seek-relative(-10); }
                    }
                    Button {
                        text: "+10 s";
                        clicked => { root.player-activity(); root.seek-relative(10); }
                    }
                    Text { text: "Audio"; color: Theme.text-secondary; vertical-alignment: center; }
                    audio-combo := ComboBox {
                        width: 180px;
                        model: root.audio-options;
                        current-index: root.audio-index;
                        enabled: root.audio-options.length > 0;
                        selected(_) => {
                            root.player-activity();
                            root.select-audio(self.current-index);
                        }
                    }
                    Text { text: "Subtitles"; color: Theme.text-secondary; vertical-alignment: center; }
                    subtitle-combo := ComboBox {
                        width: 180px;
                        model: root.subtitle-options;
                        current-index: root.subtitle-index;
                        enabled: root.subtitle-options.length > 0;
                        selected(_) => {
                            root.player-activity();
                            root.select-subtitle(self.current-index);
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "Volume"; color: Theme.text-secondary; vertical-alignment: center; }
                    Slider {
                        minimum: 0;
                        maximum: 100;
                        value: root.volume;
                        width: 150px;
                        changed(value) => {
                            root.player-activity();
                            root.volume = value;
                            root.volume-changed(value);
                        }
                    }
                    Button {
                        text: root.fullscreen-player ? "Exit Fullscreen" : "Fullscreen";
                        clicked => { root.player-activity(); root.toggle-fullscreen(); }
                    }
                }
            }
        }
    }
    }
}
